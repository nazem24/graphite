<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Paper" (light): only the surfaces. ThemeService merges this after
         Colors.Light.xaml, so text and accents stay the theme's own.
         Matte paper: warm cream, a faint grain (ThemeService draws it), ink-brown lines and manila-style folders. -->

    <SolidColorBrush x:Key="App.BackgroundBrush" Color="#FFF4EEE0"/>

    <SolidColorBrush x:Key="App.PanelBrush" Color="#D8FBF6EA"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#1A8A6F4A"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0FDF9EF" Offset="0"/>
        <GradientStop Color="#E8F8F1E2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassBorderBrush" Color="#66705A3C"/>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#FFFBF6EA"/>
    <!-- Fill of small floating surfaces: the page bar and tooltips. -->
    <SolidColorBrush x:Key="App.FloatingBrush" Color="#FFFDF9F0"/>

    <SolidColorBrush x:Key="App.StrokeBrush" Color="#4D705A3C"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#2E705A3C"/>

    <!-- how strongly the start page's glows show, and their colours (AmbientBackdrop; the accent when not set) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">0</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile): see the other materials for how these numbers work. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">1</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.92</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.25</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1.5</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF3E0B0" Offset="0"/>
        <GradientStop Color="#FFEAD18F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
        <GradientStop Color="#40FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3705A3C" Offset="0"/>
        <GradientStop Color="#80705A3C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#0F3A2A10"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <SolidColorBrush x:Key="App.PopupBrush" Color="#FFFDF9F0"/>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FFC9B99C"/>

</ResourceDictionary>
