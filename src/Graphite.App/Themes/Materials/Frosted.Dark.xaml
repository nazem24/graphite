<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Frosted" (dark): only the translucent surfaces. ThemeService merges this after
         Colors.Dark.xaml, so text, strokes and accents stay the theme's own.
         The same blur with a heavy milky tint. Panels are more opaque and calm, text stays easy to read. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#C21E1E22"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#4A121216"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D0383840" Offset="0"/>
        <GradientStop Color="#C22C2C33" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1FFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#F02A2A2E"/>

    <!-- Outlines on a see-through surface: a touch brighter than the opaque dark theme's, so
         controls keep a crisp edge against the lighter backdrop. -->
    <SolidColorBrush x:Key="App.StrokeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#1FFFFFFF"/>

    <!-- how strongly the start page's accent glows show (AmbientBackdrop) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">0.6</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile). Numbers from the design sheet
         "Folder flap across every material": the back panel is the folder colour at BackOpacity; the front flap
         is the same colour pushed dark or light by FlapTint, shown at FlapOpacity over the papers (at GhostOpacity, blurred by GhostBlur). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">0.95</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.86</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.22</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.5</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3000000" Offset="0"/>
        <GradientStop Color="#F2000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#73FFFFFF" Offset="0"/>
        <GradientStop Color="#29FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#1AFFFFFF"/>

</ResourceDictionary>
