<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Ink" (dark): only the surfaces. ThemeService merges this after
         Colors.Dark.xaml, so text and accents stay the theme's own.
         Flat and opaque: near-black surfaces, hairline outlines, no sheen and no glow. Easy on OLED screens. -->

    <SolidColorBrush x:Key="App.BackgroundBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="App.PanelBrush" Color="#FF0B0B0C"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#FF000000"/>

    <SolidColorBrush x:Key="App.GlassBrush" Color="#FF111113"/>
    <SolidColorBrush x:Key="App.GlassBorderBrush" Color="#FF2E2E32"/>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#FF131315"/>
    <!-- Fill of small floating surfaces: the page bar and tooltips. -->
    <SolidColorBrush x:Key="App.FloatingBrush" Color="#FF161618"/>

    <SolidColorBrush x:Key="App.StrokeBrush" Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#FF1B1B1E"/>

    <!-- how strongly the start page's glows show, and their colours (AmbientBackdrop; the accent when not set) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">0</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile): see the other materials for how these numbers work. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">1</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">1</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.18</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF000000" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapSheen" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Folder.FlapRim" Color="#FF2E2E32"/>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#14FFFFFF"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <SolidColorBrush x:Key="App.PopupBrush" Color="#FF161618"/>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FF2E2E32"/>

</ResourceDictionary>
