<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Ink" (light): only the surfaces. ThemeService merges this after
         Colors.Light.xaml, so text and accents stay the theme's own.
         Flat and opaque: white surfaces with thin grey lines, like a printed page. No sheen and no glow. -->

    <SolidColorBrush x:Key="App.BackgroundBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="App.PanelBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#FFF6F6F6"/>

    <SolidColorBrush x:Key="App.GlassBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="App.GlassBorderBrush" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#FFFFFFFF"/>
    <!-- Fill of small floating surfaces: the page bar and tooltips. -->
    <SolidColorBrush x:Key="App.FloatingBrush" Color="#FFFFFFFF"/>

    <SolidColorBrush x:Key="App.StrokeBrush" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#FFE6E6E6"/>

    <!-- how strongly the start page's glows show, and their colours (AmbientBackdrop; the accent when not set) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">0</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile): see the other materials for how these numbers work. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">1</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.9</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">0</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.2</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapSheen" Color="#00FFFFFF"/>
    <SolidColorBrush x:Key="Folder.FlapRim" Color="#FFD2D2D2"/>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#0F000000"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <SolidColorBrush x:Key="App.PopupBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FFD2D2D2"/>

</ResourceDictionary>
