<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Mica" (light): only the translucent surfaces. ThemeService merges this after
         Colors.Light.xaml, so text, strokes and accents stay the theme's own.
         Windows 11 Mica: a soft, nearly solid backdrop tinted by your wallpaper. This is the original look. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#A6FFFFFF"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#28C9C9C4"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B8FFFFFF" Offset="0"/>
        <GradientStop Color="#92FDFDFB" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#33B9B9B2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#E8FCFCFA"/>

    <!-- how strongly the start page's accent glows show (AmbientBackdrop) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">1.0</sys:Double>

</ResourceDictionary>
