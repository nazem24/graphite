<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Blur" (dark): only the translucent surfaces. ThemeService merges this after
         Colors.Dark.xaml, so text, strokes and accents stay the theme's own.
         Windows blurs whatever is behind the window. Light tint, so the desktop shows through softly. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#661B1B1D"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#260E0E10"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A2E2E33" Offset="0"/>
        <GradientStop Color="#66232327" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#55FFFFFF" Offset="0"/>
        <GradientStop Color="#18FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#E02A2A2E"/>
    <!-- Fill of small floating surfaces: the page bar (MainWindow, Tag="PageBar") and tooltips. -->
    <LinearGradientBrush x:Key="App.FloatingBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7A2E2E33" Offset="0"/>
        <GradientStop Color="#66232327" Offset="1"/>
    </LinearGradientBrush>

    <!-- Outlines on a see-through surface: a touch brighter than the opaque dark theme's, so
         controls keep a crisp edge against the lighter backdrop. -->
    <SolidColorBrush x:Key="App.StrokeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#1FFFFFFF"/>

    <!-- how strongly the start page's accent glows show (AmbientBackdrop) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">1.3</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile). Numbers from the design sheet
         "Folder flap across every material": the back panel is the folder colour at BackOpacity; the front flap
         is the same colour pushed dark or light by FlapTint, shown at FlapOpacity over the papers (at GhostOpacity, blurred by GhostBlur). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">0.86</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.62</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.26</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">8</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.4</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6000000" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1AFFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#26FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#1AFFFFFF"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <SolidColorBrush x:Key="App.PopupBrush" Color="#FF28282C"/>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FF47474D"/>

</ResourceDictionary>
