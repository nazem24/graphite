<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Aurora" (dark): only the surfaces. ThemeService merges this after
         Colors.Dark.xaml, so text and accents stay the theme's own.
         Near-black glass with a teal to violet shimmer, and a strong glow on the start page. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#580B1118"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#30000000"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2A5EF2D2" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#32A070F0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6B8FFF0" Offset="0"/>
        <GradientStop Color="#2E8FE6DC" Offset="0.32"/>
        <GradientStop Color="#14B49CF0" Offset="0.68"/>
        <GradientStop Color="#52C6A8FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#E60C1218"/>
    <!-- Fill of small floating surfaces: the page bar and tooltips. -->
    <LinearGradientBrush x:Key="App.FloatingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B0123238" Offset="0"/>
        <GradientStop Color="#A80C1620" Offset="0.5"/>
        <GradientStop Color="#B01E1A3C" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="App.StrokeBrush" Color="#33C8F2EE"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#1FC8F2EE"/>

    <!-- how strongly the start page's glows show, and their colours (AmbientBackdrop; the accent when not set) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">2.5</sys:Double>
    <Color x:Key="App.AmbientColorA">#2EE6C6</Color>
    <Color x:Key="App.AmbientColorB">#8A5CF5</Color>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile): see the other materials for how these numbers work. -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">0.72</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.46</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">6</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.25</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6000000" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C8CFFEA" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#269A78F2" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6B8FFF0" Offset="0"/>
        <GradientStop Color="#2E8FE6DC" Offset="0.32"/>
        <GradientStop Color="#14B49CF0" Offset="0.68"/>
        <GradientStop Color="#52C6A8FF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#1AFFFFFF"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <LinearGradientBrush x:Key="App.PopupBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF102A30" Offset="0"/>
        <GradientStop Color="#FF14162E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FF2F6A6E"/>

</ResourceDictionary>
