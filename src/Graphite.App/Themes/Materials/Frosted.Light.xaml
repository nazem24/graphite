<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Frosted" (light): only the translucent surfaces. ThemeService merges this after
         Colors.Light.xaml, so text, strokes and accents stay the theme's own.
         The same blur with a heavy milky tint. Panels are more opaque and calm, text stays easy to read. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#D6FFFFFF"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#40D8D8D4"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D4F6F6F3" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#4DB9B9B2" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#F0FFFFFF"/>
    <!-- Fill of small floating surfaces: the page bar (MainWindow, Tag="PageBar") and tooltips. -->
    <LinearGradientBrush x:Key="App.FloatingBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#D4F6F6F3" Offset="1"/>
    </LinearGradientBrush>

    <!-- how strongly the start page's accent glows show (AmbientBackdrop) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">0.6</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile). Numbers from the design sheet
         "Folder flap across every material": the back panel is the folder colour at BackOpacity; the front flap
         is the same colour pushed dark or light by FlapTint, shown at FlapOpacity over the papers (at GhostOpacity, blurred by GhostBlur). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">0.95</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.9</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.4</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1.5</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#FFFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00FFFFFF" Offset="0.3"/>
        <GradientStop Color="#40FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#F2FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#0F000000"/>


    <!-- Pop-ups (tooltips, drop-downs, menus, colour cards) are windows of their own, so nothing blurs behind them:
         they get one solid surface per material instead of the see-through glass. -->
    <SolidColorBrush x:Key="App.PopupBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="App.PopupBorderBrush" Color="#FFD9D9D4"/>

</ResourceDictionary>
