<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material "Glass" (dark): only the translucent surfaces. ThemeService merges this after
         Colors.Dark.xaml, so text, strokes and accents stay the theme's own.
         Clear glass with some depth: a soft sheen across the top-left that fades into a cool tint, and a thin
         rim of light on the diagonal corners instead of a flat white outline. -->

    <SolidColorBrush x:Key="App.PanelBrush" Color="#4A14151B"/>
    <SolidColorBrush x:Key="App.ViewerBrush" Color="#26000000"/>

    <LinearGradientBrush x:Key="App.GlassBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2CFFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="0.5"/>
        <GradientStop Color="#228FA0D0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="App.GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6FFFFFF" Offset="0"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.32"/>
        <GradientStop Color="#14FFFFFF" Offset="0.68"/>
        <GradientStop Color="#52FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="App.GlassSolidBrush" Color="#E61E2026"/>
    <!-- Fill of small floating surfaces: the page bar (MainWindow, Tag="PageBar") and tooltips. -->
    <!-- Same diagonal sheen as the Glass surface, shaded: more opaque so the controls stay legible -->
    <LinearGradientBrush x:Key="App.FloatingBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B02C303A" Offset="0"/>
        <GradientStop Color="#A81C1F27" Offset="0.5"/>
        <GradientStop Color="#B0222A3E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Outlines on a see-through surface: a touch brighter than the opaque dark theme's, so
         controls keep a crisp edge against the lighter backdrop. -->
    <SolidColorBrush x:Key="App.StrokeBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="App.StrokeSoftBrush" Color="#1FFFFFFF"/>

    <!-- how strongly the start page's accent glows show (AmbientBackdrop) -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="App.AmbientStrength">1.6</sys:Double>

    <!-- Folder cards on the start page (LibraryHome, style FolderTile). Numbers from the design sheet
         "Folder flap across every material": the back panel is the folder colour at BackOpacity; the front flap
         is the same colour pushed dark or light by FlapTint, shown at FlapOpacity over the papers (at GhostOpacity, blurred by GhostBlur). -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.BackOpacity">0.72</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.FlapOpacity">0.46</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.ShadowOpacity">0.14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostBlur">6</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Folder.GhostOpacity">0.25</sys:Double>
    <Visibility x:Key="Folder.GhostVisibility">Visible</Visibility>
    <RectangleGeometry x:Key="Folder.PapersClip" Rect="-60,-80,342,166"/>
    <Thickness x:Key="Folder.FlapRimThickness">1</Thickness>
    <LinearGradientBrush x:Key="Folder.FlapTint" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6000000" Offset="0"/>
        <GradientStop Color="#FF000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapSheen" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2CFFFFFF" Offset="0"/>
        <GradientStop Color="#12FFFFFF" Offset="0.5"/>
        <GradientStop Color="#228FA0D0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Folder.FlapRim" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6FFFFFF" Offset="0"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.32"/>
        <GradientStop Color="#14FFFFFF" Offset="0.68"/>
        <GradientStop Color="#52FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Folder.FlapHover" Color="#1FFFFFFF"/>

</ResourceDictionary>
