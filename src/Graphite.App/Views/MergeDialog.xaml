<Window x:Class="Graphite.App.Views.MergeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" Width="560" Height="600"
        Title="Merge PDFs"
        Style="{StaticResource DialogWindow}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="{DynamicResource App.BackgroundBrush}"
        TextElement.Foreground="{DynamicResource App.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5">
    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="PromptText" Style="{StaticResource Body}" TextWrapping="Wrap" TextTrimming="None"
                       Text="Files are joined in the order shown. Drop PDFs anywhere in this window to add them."
                       Margin="0,0,130,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" Margin="0,0,6,0"/>
                    <TextBlock Text="Add files…" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource App.PanelBrush}"
                BorderBrush="{DynamicResource App.StrokeSoftBrush}" BorderThickness="1" CornerRadius="14">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                    <ItemsControl x:Name="FileList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.CardBrush}" CornerRadius="10" Margin="0,0,0,6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Number}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1" Width="46" Height="60" Margin="0,0,12,0">
                                            <Grid Width="{Binding ThumbW}" Height="{Binding ThumbH}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource App.StrokeSoftBrush}" CornerRadius="3"/>
                                                <Image Source="{Binding Thumb}" Stretch="Fill"/>
                                                <Border BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1" CornerRadius="3"/>
                                            </Grid>
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Info}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Move up" Click="Up_Click">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronUp}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Move down" Click="Down_Click">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Padding="6" ToolTip="Remove" Click="Remove_Click">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Merge}" Width="28" Height="28"
                          Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="Drop PDFs here, or choose Add files" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" Margin="0,0,200,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkButton" Content="Merge" Style="{StaticResource AccentButton}" IsDefault="True"
                        IsEnabled="False" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
