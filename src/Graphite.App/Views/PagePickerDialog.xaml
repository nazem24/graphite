<Window x:Class="Graphite.App.Views.PagePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" Width="700" Height="680"
        Style="{StaticResource DialogWindow}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource App.BackgroundBrush}"
        TextElement.Foreground="{DynamicResource App.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5">
    <Window.Resources>
        <!-- One page tile: thumbnail, number, and a ring + check badge when picked.
             Pick.Brush is set from code (accent, or red when deleting). -->
        <Style x:Key="TileButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Border x:Name="hover" Background="{DynamicResource App.HoverBrush}" CornerRadius="12" Opacity="0"/>
                            <Border x:Name="sel" Background="{DynamicResource Pick.Brush}" CornerRadius="12" Opacity="0"/>
                            <Border x:Name="ring" BorderBrush="{DynamicResource Pick.Brush}" BorderThickness="2"
                                    CornerRadius="12" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="badge" Width="22" Height="22" CornerRadius="11"
                                    Background="{DynamicResource Pick.Brush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Opacity="0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}"
                                      Stroke="White" StrokeThickness="1.9"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="sel" Property="Opacity" Value="0.14"/>
                                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                                <Setter TargetName="badge" Property="Opacity" Value="1"/>
                                <Setter TargetName="hover" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Style="{StaticResource Body}" TextWrapping="Wrap"
                   TextTrimming="None" Margin="0,0,0,12"/>

        <!-- quick picks + range box -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="All" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="All_Click"/>
                <Button Content="None" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="None_Click"/>
                <Button Content="Odd" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Click="Odd_Click"/>
                <Button Content="Even" Style="{StaticResource GhostButton}" Click="Even_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Pages" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="RangeBox" Width="200" TextChanged="RangeBox_TextChanged"
                         ToolTip="Type pages or ranges, e.g. 1, 3-5, 9"/>
            </StackPanel>
        </Grid>

        <!-- thumbnails -->
        <Border Grid.Row="2" Background="{DynamicResource App.PanelBrush}"
                BorderBrush="{DynamicResource App.StrokeSoftBrush}" BorderThickness="1" CornerRadius="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                <ItemsControl x:Name="Tiles">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource TileButton}" Width="124" Height="190" Margin="3"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid Width="108" Height="148">
                                        <Grid Width="{Binding ThumbW}" Height="{Binding ThumbH}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource App.StrokeSoftBrush}" CornerRadius="3"/>
                                            <Image Source="{Binding Thumb}" Stretch="Fill"/>
                                            <Border BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1"
                                                    CornerRadius="3"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- where to put inserted pages -->
        <StackPanel x:Name="PlacementPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Text="PLACE THEM" Style="{StaticResource SectionLabel}" Margin="2,0,0,4"/>
            <UniformGrid Columns="2">
                <RadioButton x:Name="AfterRadio" GroupName="Place" IsChecked="True" Style="{StaticResource OptionRow}" Margin="0,0,4,2"/>
                <RadioButton x:Name="BeforeRadio" GroupName="Place" Style="{StaticResource OptionRow}" Margin="4,0,0,2"/>
                <RadioButton x:Name="StartRadio" GroupName="Place" Style="{StaticResource OptionRow}" Margin="0,0,4,0">
                    <TextBlock Text="At the start of the document"/>
                </RadioButton>
                <RadioButton x:Name="EndRadio" GroupName="Place" Style="{StaticResource OptionRow}" Margin="4,0,0,0">
                    <TextBlock Text="At the end of the document"/>
                </RadioButton>
            </UniformGrid>
        </StackPanel>

        <!-- footer -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0" IsCancel="True"/>
                <Button x:Name="OkButton" Style="{StaticResource AccentButton}" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
