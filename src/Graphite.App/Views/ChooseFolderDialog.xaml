<Window x:Class="Graphite.App.Views.ChooseFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graphite.App.ViewModels"
        xmlns:conv="clr-namespace:Graphite.App.Converters"
        Title="Choose your main folder" Width="660" Height="660" MinHeight="540"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource App.BackgroundBrush}"
        TextElement.Foreground="{DynamicResource App.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <!-- A tree row: flat, rounded, tinted with the accent when selected. -->
        <Style x:Key="TreeRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="6,5" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="26,22,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Choose your main folder" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap"
                   TextTrimming="None" Margin="0,6,0,16"
                   Text="Graphite lists its subfolders and PDFs on the start screen, so you can open files in one click. It only reads this folder: nothing is copied or uploaded."/>

        <!-- where the selection sits -->
        <Border Grid.Row="2" CornerRadius="14" Padding="14,9" Background="{DynamicResource App.CardBrush}"
                BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}" Width="14" Height="14"
                      Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding PathText}" Style="{StaticResource Body}" FontWeight="SemiBold"
                           Margin="9,0,0,0" VerticalAlignment="Center" MaxWidth="540"/>
            </StackPanel>
        </Border>

        <!-- the folder tree, opened at OneDrive -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="14" Background="{DynamicResource App.CardBrush}"
                BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1" Padding="4">
            <ListBox x:Name="Tree" Style="{StaticResource GList}" ItemContainerStyle="{StaticResource TreeRow}"
                     ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FolderNode}">
                        <Grid Margin="{Binding Indent}" Background="Transparent"
                              MouseLeftButtonDown="Row_MouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource IconButton}" Padding="3" Click="Chevron_Click"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Show subfolders">
                                <Grid Width="10" Height="10">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource InvBoolToVis}}"/>
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                          Width="10" Height="10" Stretch="Uniform"
                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                            <Grid Grid.Column="1" Width="14" Height="14" Margin="2,0,9,0">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Visibility="{Binding IsCloud, Converter={StaticResource BoolToVis}}"/>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Visibility="{Binding IsCloud, Converter={StaticResource InvBoolToVis}}"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource App.AccentSystemBrush}" Margin="12,0,6,0"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- live preview of what the choice contains -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="4,14,0,0">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}" Width="13" Height="13"
                  Stretch="Uniform" Stroke="#4E9C51" Margin="0,0,8,0" VerticalAlignment="Center"
                  Visibility="{Binding StatusOk, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="12.5"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Office files -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="4,12,0,0">
            <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding IncludeOffice, Mode=TwoWay}"
                          VerticalAlignment="Center"/>
            <TextBlock Text="Also list Word, Excel and PowerPoint files (converted to PDF when opened)"
                       Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <DockPanel Grid.Row="6" Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Browse this PC…"
                    Click="Browse_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Use this folder"
                    IsDefault="True" IsEnabled="{Binding CanUse}" Click="Use_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel" IsCancel="True"
                    Margin="0,0,10,0"/>
        </DockPanel>
    </Grid>
</Window>
