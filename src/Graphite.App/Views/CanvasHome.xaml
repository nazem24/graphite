<UserControl x:Class="Graphite.App.Views.CanvasHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graphite.App.ViewModels"
             xmlns:conv="clr-namespace:Graphite.App.Converters"
             xmlns:svc="clr-namespace:Graphite.App.Services"
             xmlns:ctrl="clr-namespace:Graphite.App.Controls"
             Focusable="False">

    <!-- The page of the Canvas space, in the start screen's content column. DataContext: CanvasViewModel.
         Built only from Graphite's own surfaces and styles (GlassCard, LibCard, RailRow, CardCornerButton,
         GhostButton, Body / Caption / SectionLabel), so every material and both modes carry over. The accent is
         kept for state, as everywhere else in Graphite: NEW, pinned, due soon. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- a group of rows: the same glass as the library's cards -->
        <Style x:Key="RowCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- the type label at the start of a row ("PDF", "PAGE", "TASK") -->
        <Style x:Key="TypeBadge" TargetType="Border">
            <Setter Property="MinWidth" Value="42"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.StrokeBrush}"/>
            <Setter Property="Background" Value="{DynamicResource App.HoverBrush}"/>
        </Style>
        <Style x:Key="TypeBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}"/>
        </Style>

        <!-- small outlined chips after a title: locked, due, on this PC -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.StrokeBrush}"/>
        </Style>
        <!-- NEW: the accent, as the unsaved-changes dot and the checked tools use it -->
        <Style x:Key="NewPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
        </Style>
        <Style x:Key="NewPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.AccentSystemBrush}"/>
        </Style>

        <!-- A course on the overview, drawn like a folder of the Local space: a back sheet in the course's own colour
             and a front flap that carries the material. Everything that depends on the theme comes from the Folder.*
             resources of the current material (the same ones LibraryHome's FolderTile reads), so changing the material
             or light / dark restyles the courses live:
               - Folder.BackOpacity / ShadowOpacity   how solid the back is, how much it shadows
               - Folder.FlapTint / FlapSheen / FlapRim / FlapOpacity   the flap: dark or light tint, sheen, edge, how much of the back shows through
               - Folder.FlapHover                      the wash on hover
             The big letters behind the title (Abbreviation) are drawn on the back, so they show through a see-through flap.
             DataContext is the CanvasCourseItem. -->
        <Style x:Key="CourseTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>

                            <!-- the artwork, one cached picture (see FolderTile): back sheet, big letters, flap -->
                            <Grid x:Name="art" IsHitTestVisible="False">
                                <Grid.CacheMode>
                                    <BitmapCache/>
                                </Grid.CacheMode>
                                <Border CornerRadius="14" Background="{Binding TintBrush}" Opacity="{DynamicResource Folder.BackOpacity}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="{DynamicResource Folder.ShadowOpacity}"/>
                                    </Border.Effect>
                                </Border>
                                <TextBlock Text="{Binding Abbreviation}" FontSize="{Binding AbbreviationSize}" FontWeight="ExtraBold"
                                           Foreground="{DynamicResource App.TextBrush}" Opacity="0.16"
                                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0"
                                           IsHitTestVisible="False"/>
                                <Grid x:Name="flap" Height="84" VerticalAlignment="Bottom">
                                    <Grid Opacity="{DynamicResource Folder.FlapOpacity}">
                                        <Border CornerRadius="14" Background="{Binding TintBrush}"/>
                                        <Border CornerRadius="14" Background="{DynamicResource Folder.FlapTint}"/>
                                    </Grid>
                                    <Border CornerRadius="14" Background="{DynamicResource Folder.FlapSheen}"/>
                                    <Border CornerRadius="14" BorderBrush="{DynamicResource Folder.FlapRim}"
                                            BorderThickness="{DynamicResource Folder.FlapRimThickness}"/>
                                </Grid>
                                <Border x:Name="hl" Height="84" VerticalAlignment="Bottom" CornerRadius="14"
                                        Background="{DynamicResource Folder.FlapHover}" Opacity="0"/>
                                <Border x:Name="ring" CornerRadius="14" BorderThickness="2"
                                        BorderBrush="{DynamicResource App.AccentSystemBrush}" Opacity="0"/>
                            </Grid>

                            <!-- the text stays outside the picture so it keeps crisp edges -->
                            <Grid IsHitTestVisible="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Width="28" Height="28" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="12,2,0,0" Background="#40000000">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Course}" Width="14" Height="14"
                                          Stretch="Uniform" Stroke="White"/>
                                </Border>
                                <Border Style="{StaticResource NewPill}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,2,12,0" BorderThickness="1" BorderBrush="{DynamicResource App.AccentSystemBrush}"
                                        Background="{DynamicResource App.FloatingBrush}"
                                        Visibility="{Binding HasNew, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding NewText}" Style="{StaticResource NewPillText}"/>
                                </Border>
                                <DockPanel Grid.Row="1" Margin="14,7,14,10" LastChildFill="True">
                                    <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0" MaxWidth="96"
                                                Visibility="{Binding IsLinked, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="10" Height="10"
                                                      Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding FolderName}" Style="{StaticResource Caption}" FontSize="10.5"
                                                           Foreground="{DynamicResource App.TextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17"
                                               LineStackingStrategy="BlockLineHeight" MaxHeight="34" VerticalAlignment="Top"/>
                                </DockPanel>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a ghost button with an icon in front of its text -->
        <Style x:Key="IconGhost" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============================ one entry of a course ============================ -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:CanvasRowVm}">
            <Grid>
                <!-- a sub-header inside a module -->
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionLabel}" Margin="14,12,8,4"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}"/>

                <Button x:Name="Row" Style="{StaticResource RailRow}" MinHeight="38" Padding="8,0,6,0"
                        Margin="{Binding IndentMargin}" ToolTip="{Binding ToolTipText}"
                        Visibility="{Binding IsHeader, Converter={StaticResource InvBoolToVis}}"
                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource TypeBadge}">
                            <TextBlock Text="{Binding Badge}" Style="{StaticResource TypeBadgeText}"/>
                        </Border>

                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   MaxWidth="460">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                            <Setter Property="Opacity" Value="0.55"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NewPill}" Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="NEW" Style="{StaticResource NewPillText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Width="10" Height="10"
                                          Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="Locked" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                            <Border Visibility="{Binding HasDue, Converter={StaticResource BoolToVis}}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource App.AccentSystemBrush}"/>
                                                <Setter Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DueText}" Style="{StaticResource Caption}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" ToolTip="This file is already in the course folder"
                                    Visibility="{Binding OnThisPc, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}" Width="10" Height="10"
                                          Stretch="Uniform" Margin="0,0,5,0"/>
                                    <TextBlock Text="On this PC" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- where it sits (New, Pinned, search) -->
                        <TextBlock Grid.Column="3" Text="{Binding PathText}" Style="{StaticResource Caption}" Margin="12,0,8,0"
                                   VerticalAlignment="Center" ToolTip="{Binding PathText}"
                                   Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Grid.Column="4" Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="8,0,10,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasMeta, Converter={StaticResource BoolToVis}}"/>

                        <!-- actions: pin (stays while pinned), and the download split button or "open in browser" -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource CardCornerButton}" ToolTip="Unpin" Margin="0,0,4,0"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pin}" Width="12" Height="12" Stretch="Uniform"
                                      Fill="{DynamicResource App.AccentSystemBrush}" Stroke="{DynamicResource App.AccentSystemBrush}"/>
                            </Button>
                            <StackPanel Orientation="Horizontal" Style="{StaticResource RevealOnCardHover}">
                                <Button Style="{StaticResource CardCornerButton}" ToolTip="Pin" Margin="0,0,4,0"
                                        Visibility="{Binding IsPinned, Converter={StaticResource InvBoolToVis}}"
                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pin}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource CardCornerButton}" ToolTip="Open in the browser"
                                        Visibility="{Binding IsLink, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.OpenRowInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                            <!-- download: the left half saves to Downloads at once, the chevron offers the other places -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource CardCornerButton}" ToolTip="Quick download (to Downloads)"
                                        Command="{Binding DataContext.QuickDownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource CardCornerButton}" ToolTip="More ways to save" Margin="2,0,0,0"
                                        Click="DownloadMenu_Click">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="9" Height="9" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- a row and, for a page, the files and links inside it -->
        <DataTemplate x:Key="RowWithLinksTemplate" DataType="{x:Type vm:CanvasRowVm}">
            <StackPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RowTemplate}"/>
                <Border Margin="30,0,0,6" Padding="6,0,0,0" BorderThickness="2,0,0,0"
                        BorderBrush="{DynamicResource App.StrokeSoftBrush}"
                        Visibility="{Binding HasLinks, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="In this page" Style="{StaticResource Caption}" Margin="8,2,0,2"/>
                        <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ============================ a module ============================ -->
        <DataTemplate x:Key="ModuleTemplate" DataType="{x:Type vm:CanvasModuleVm}">
            <Border Style="{StaticResource RowCard}">
                <StackPanel>
                    <Button Style="{StaticResource RailRow}" MinHeight="42" Padding="10,0,6,0"
                            Command="{Binding DataContext.ToggleModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Fold or unfold">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Chip}" Visibility="{Binding HasUnlock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UnlockText}" Style="{StaticResource Caption}"/>
                                </Border>
                                <TextBlock Text="{Binding FileCountText}" Style="{StaticResource Caption}" Margin="10,0,8,0"
                                           VerticalAlignment="Center" Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource CardCornerButton}" ToolTip="Download all files of this module as a ZIP"
                                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.DownloadModuleZipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Archive}" Width="12" Height="12" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                            <Grid DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10"
                                      Stretch="Uniform" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}" Width="10" Height="10"
                                      Stretch="Uniform" Visibility="{Binding IsExpanded, Converter={StaticResource InvBoolToVis}}"/>
                            </Grid>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13.5"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="10,2,10,4"/>
                        <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowWithLinksTemplate}"
                                      Focusable="False" Visibility="{Binding IsRealized, Converter={StaticResource BoolToVis}}"/>
                        <Border Height="{Binding PlaceholderHeight}" IsHitTestVisible="False"
                                Visibility="{Binding IsRealized, Converter={StaticResource InvBoolToVis}}"/>
                        <TextBlock Text="No items" Style="{StaticResource Caption}" Margin="14,6,0,8"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============================ a group of rows (New, Pinned, search) ============================ -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:CanvasSectionVm}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13.5"
                           Margin="4,4,0,8"/>
                <Border Style="{StaticResource RowCard}">
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                </Border>
                <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="6,-4,0,8"
                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ============================ "New since you last looked": one course, up to three items ============================ -->
        <DataTemplate x:Key="NewCardTemplate" DataType="{x:Type vm:CanvasSectionVm}">
            <Grid Width="478" Height="176" Margin="0,0,14,14">
            <Border Style="{StaticResource RowCard}" Margin="0" Padding="10,8,10,6">
                <StackPanel>
                    <DockPanel Margin="4,0,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Mark seen" FontSize="11.5"
                                Padding="8,2" Margin="6,0,0,0" ToolTip="Mark this course's new items as seen"
                                Click="NewCardSeen_Click"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CanvasRowVm}">
                                <Button Style="{StaticResource RailRow}" MinHeight="32" Padding="6,0" ToolTip="{Binding ToolTipText}"
                                        Command="{Binding DataContext.OpenRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Style="{StaticResource TypeBadge}">
                                            <TextBlock Text="{Binding Badge}" Style="{StaticResource TypeBadgeText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" Margin="8,0,0,0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="6,2,0,2"
                               Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
            <!-- the course's colour, as a wash over the card -->
            <Border CornerRadius="14" Background="{Binding TintBrush}" Opacity="0.24" IsHitTestVisible="False"/>
            </Grid>
        </DataTemplate>

        <!-- ============================ a course card on the overview ============================ -->
        <DataTemplate x:Key="CourseCardTemplate" DataType="{x:Type vm:CanvasCourseItem}">
            <Button Style="{StaticResource CourseTile}" Width="232" Height="124" Margin="0,0,14,14" ToolTip="{Binding Tip}"
                    AutomationProperties.Name="{Binding Name}"
                    Command="{Binding DataContext.OpenCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"/>
        </DataTemplate>

        <!-- ============================ the calendar ============================
             Month, Week and Agenda (see CanvasViewModel.Calendar.cs). Built from the same glass cards and brushes as
             everything else; only the three kind colours are fixed (lecture, due, exam), the bar of an entry is the
             colour of its course. -->
        <SolidColorBrush x:Key="Cal.LectureBrush" Color="#6FA3F7"/>
        <SolidColorBrush x:Key="Cal.DueBrush" Color="#F2A35E"/>
        <SolidColorBrush x:Key="Cal.ExamBrush" Color="#EE7B97"/>
        <SolidColorBrush x:Key="Cal.DueWash" Color="#30F2A35E"/>
        <SolidColorBrush x:Key="Cal.ExamWash" Color="#30EE7B97"/>

        <!-- a button that is only its content (a day of the month grid) -->
        <Style x:Key="CalCellButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KindBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="{DynamicResource App.StrokeBrush}"/>
        </Style>

        <!-- a chip in a month cell: the course's bar, then "Finance 10:15" / "Due: Essay outline" -->
        <DataTemplate x:Key="CalChipTemplate" DataType="{x:Type vm:CalendarEntryVm}">
            <Border x:Name="chip" CornerRadius="5" Margin="0,2,0,0" Background="{DynamicResource Cal.ChipBrush}"
                    ToolTip="{Binding Title}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="5,0,0,5" Background="{Binding Tint}"/>
                    <TextBlock Text="{Binding ChipText}" FontSize="10.5" Margin="6,2,4,2" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.TextBrush}"/>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDeadline}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{StaticResource Cal.DueWash}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExam}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{StaticResource Cal.ExamWash}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a day of the month grid -->
        <DataTemplate x:Key="MonthCellTemplate" DataType="{x:Type vm:CalendarDayVm}">
            <Button Style="{StaticResource CalCellButton}" Margin="3"
                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Border x:Name="cell" CornerRadius="12" MinHeight="98" Padding="8,6,8,8" BorderThickness="1.5"
                        BorderBrush="{DynamicResource Cal.CellBorderBrush}" Background="{DynamicResource Cal.CellOutBrush}">
                    <StackPanel>
                        <Border x:Name="num" HorizontalAlignment="Left" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0"
                                Margin="-4,0,0,2">
                            <TextBlock x:Name="numText" Text="{Binding DayNumber}" FontSize="11.5" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Cal.MutedTextBrush}"/>
                        </Border>
                        <ItemsControl x:Name="chips" Opacity="0.7" ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource CalChipTemplate}"
                                      Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="2,3,0,0"
                                   Foreground="{DynamicResource Cal.MutedTextBrush}"
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding InMonth}" Value="True">
                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Cal.CellBrush}"/>
                    <Setter TargetName="chips" Property="Opacity" Value="1"/>
                    <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Cal.CellBrush}"/>
                    <Setter TargetName="chips" Property="Opacity" Value="1"/>
                    <Setter TargetName="num" Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
                    <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource App.AccentSystemBrush}"/>
                    <Setter TargetName="numText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="cell" Property="Background" Value="{DynamicResource Cal.CellBrush}"/>
                    <Setter TargetName="chips" Property="Opacity" Value="1"/>
                    <Setter TargetName="cell" Property="BorderBrush" Value="{DynamicResource App.AccentSystemBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one line of "what is on this day" (month side panel) -->
        <DataTemplate x:Key="DayEntryTemplate" DataType="{x:Type vm:CalendarEntryVm}">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0"
                           VerticalAlignment="Top"/>
                <Border Grid.Column="1" Width="3" CornerRadius="2" Margin="0,0,10,0" Background="{Binding Tint}"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"
                               Foreground="{DynamicResource App.TextBrush}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Margin="0,2,0,0" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource KindBadge}" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource TypeBadgeText}"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- a deadline (or all-day entry) above the week grid -->
        <DataTemplate x:Key="CalWeekChipTemplate" DataType="{x:Type vm:CalendarEntryVm}">
            <Button Style="{StaticResource CalCellButton}" Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" ToolTip="{Binding Title}">
                <Border x:Name="chip" CornerRadius="6" Margin="0,3,0,0" Background="{DynamicResource App.HoverBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="3" CornerRadius="6,0,0,6" Background="{Binding Tint}"/>
                        <TextBlock Text="{Binding WeekChipText}" FontSize="11" Margin="6,3,4,3" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.TextBrush}"/>
                    </DockPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDeadline}" Value="True">
                    <Setter TargetName="chip" Property="Background" Value="{StaticResource Cal.DueWash}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a day's heading in the week view: MON 19, and its deadlines under it -->
        <DataTemplate x:Key="WeekHeaderTemplate" DataType="{x:Type vm:CalendarDayVm}">
            <StackPanel Margin="5,0,5,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding WeekdayLabel}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    <Border x:Name="num" Margin="6,0,0,0" MinWidth="22" Height="22" CornerRadius="11" Padding="6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="numText" Text="{Binding DayNumber}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.TextBrush}"/>
                    </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource CalWeekChipTemplate}" Focusable="False"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="num" Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
                    <Setter TargetName="numText" Property="Foreground" Value="{DynamicResource App.AccentSystemBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a lecture or exam in the week grid -->
        <DataTemplate x:Key="WeekBlockTemplate" DataType="{x:Type vm:CalendarEntryVm}">
            <Border x:Name="block" CornerRadius="8" BorderThickness="1" ToolTip="{Binding Title}"
                    Background="{DynamicResource App.HoverBrush}" BorderBrush="{DynamicResource App.StrokeSoftBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="3" CornerRadius="8,0,0,8" Background="{Binding Tint}"/>
                    <StackPanel Margin="7,5,5,3" ClipToBounds="True">
                        <TextBlock Text="{Binding ShortTitle}" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource App.TextBrush}"/>
                        <TextBlock Text="{Binding BlockDetail}" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExam}" Value="True">
                    <Setter TargetName="block" Property="Background" Value="{StaticResource Cal.ExamWash}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one day's column of the week grid -->
        <DataTemplate x:Key="WeekColumnTemplate" DataType="{x:Type vm:CalendarDayVm}">
            <Border x:Name="col" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource App.StrokeSoftBrush}">
                <ItemsControl ItemsSource="{Binding Timed}" ItemTemplate="{StaticResource WeekBlockTemplate}" Focusable="False"
                              Height="{Binding DataContext.WeekHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctrl:WeekColumnPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="ctrl:WeekColumnPanel.Top" Value="{Binding BlockTop}"/>
                            <Setter Property="ctrl:WeekColumnPanel.BlockHeight" Value="{Binding BlockHeight}"/>
                            <Setter Property="ctrl:WeekColumnPanel.Col" Value="{Binding Col}"/>
                            <Setter Property="ctrl:WeekColumnPanel.Cols" Value="{Binding Cols}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="col" Property="Background" Value="{DynamicResource App.AccentSoftBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- one entry of the agenda -->
        <DataTemplate x:Key="AgendaEntryTemplate" DataType="{x:Type vm:CalendarEntryVm}">
            <Grid Margin="10,8,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Body}" FontSize="12.5" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Width="3" CornerRadius="2" Margin="0,0,12,0" Background="{Binding Tint}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource App.TextBrush}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,2,0,0"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Border Grid.Column="3" Style="{StaticResource KindBadge}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding KindLabel}" Style="{StaticResource TypeBadgeText}"/>
                </Border>
                <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Open in Canvas" FontSize="11.5" Padding="10,3"
                        Margin="10,0,0,0" VerticalAlignment="Center"
                        Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>

        <!-- a day of the agenda -->
        <DataTemplate x:Key="AgendaGroupTemplate" DataType="{x:Type vm:CalendarAgendaGroup}">
            <Border Style="{StaticResource RowCard}" Padding="8,10,8,6">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,4">
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource App.TextBrush}"/>
                        <TextBlock Text="{Binding Date}" Style="{StaticResource Caption}" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource AgendaEntryTemplate}" Focusable="False"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- a number of the little calendar beside the agenda, with a dot for each kind that day has -->
        <DataTemplate x:Key="MiniDayTemplate" DataType="{x:Type vm:CalendarDayVm}">
            <Grid Height="32">
                <Border x:Name="today" CornerRadius="8" Margin="2" Visibility="Collapsed" Background="{DynamicResource App.AccentSoftBrush}"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="n" Text="{Binding DayNumber}" FontSize="11.5" HorizontalAlignment="Center"
                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="5" Margin="0,1,0,0">
                        <Ellipse Width="4" Height="4" Margin="1,0" Fill="{StaticResource Cal.LectureBrush}"
                                 Visibility="{Binding HasLectureDot, Converter={StaticResource BoolToVis}}"/>
                        <Ellipse Width="4" Height="4" Margin="1,0" Fill="{StaticResource Cal.DueBrush}"
                                 Visibility="{Binding HasDueDot, Converter={StaticResource BoolToVis}}"/>
                        <Ellipse Width="4" Height="4" Margin="1,0" Fill="{StaticResource Cal.ExamBrush}"
                                 Visibility="{Binding HasExamDot, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding InMonth}" Value="True">
                    <Setter TargetName="n" Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="today" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="n" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================ the calendar strip on the overview: same size as a "New" card ============================ -->
        <DataTemplate x:Key="StripCardTemplate" DataType="{x:Type vm:CalendarStripCard}">
            <Border Style="{StaticResource RowCard}" Margin="0,0,14,14" Padding="14,10,14,6">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="13"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CalendarEntryVm}">
                                <Button ToolTip="{Binding Title}"
                                        Command="{Binding DataContext.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource CalCellButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUrl}" Value="False">
                                                    <Setter Property="Cursor" Value="Arrow"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid MinHeight="30" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StripText}" Style="{StaticResource Caption}" FontSize="11.5"
                                                   VerticalAlignment="Top" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        <Border Grid.Column="1" Width="3" CornerRadius="2" Margin="0,2,10,2" Background="{Binding Tint}"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,10,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding MoreText}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                               Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Month / Week / Agenda: the view that appears fades in and settles a few pixels, so switching does not jump -->
        <Storyboard x:Key="CalViewInStory">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
        <Style x:Key="CalViewIn" TargetType="Grid">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CalViewInStory}"/></Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CalGlassIn" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource CalViewInStory}"/></Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="PageRoot" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header: what this is, and what can be done with it -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,6,0,0">
                    <!-- a course -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCoursePage, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconGhost}" Command="{Binding MarkAllSeenCommand}"
                                ToolTip="Clear the NEW marks of this course"
                                Visibility="{Binding CurrentCourse.HasNew, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}" Width="12" Height="12" Stretch="Uniform"/>
                                <TextBlock Text="Mark all seen" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconGhost}" Command="{Binding ToggleAllModulesCommand}"
                                Visibility="{Binding HasModules, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <TextBlock Text="Collapse all" Visibility="{Binding AllCollapsed, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBlock Text="Expand all" Visibility="{Binding AllCollapsed, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        <!-- linked: the folder's name opens its menu; not linked: offer to link -->
                        <Button Style="{StaticResource IconGhost}" Click="FolderMenu_Click" ToolTip="{Binding CourseFolder}"
                                Visibility="{Binding IsCourseLinked, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="13" Height="13" Stretch="Uniform"/>
                                <TextBlock Text="{Binding CourseFolderName}" Margin="7,0,0,0" MaxWidth="160"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}" Width="9" Height="9"
                                      Stretch="Uniform" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconGhost}" Command="{Binding LinkFolderCommand}"
                                ToolTip="Keep this course's files in a folder of yours: opened files are saved there and recognised later, even renamed"
                                Visibility="{Binding IsCourseLinked, Converter={StaticResource InvBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Link}" Width="13" Height="13" Stretch="Uniform"/>
                                <TextBlock Text="Link folder…" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconGhost}" Command="{Binding OpenInCanvasCommand}" ToolTip="Open this course on the Canvas website">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}" Width="13" Height="13" Stretch="Uniform"/>
                                <TextBlock Text="Canvas" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- the calendar: view, and moving through time -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsCalendarPage, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource SegmentTray}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource SegmentOption}" GroupName="calMode" Padding="14,5" Content="Month"
                                             IsChecked="{Binding IsMonthMode, Mode=OneWay}" Command="{Binding ShowMonthCommand}"/>
                                <RadioButton Style="{StaticResource SegmentOption}" GroupName="calMode" Padding="14,5" Content="Week"
                                             IsChecked="{Binding IsWeekMode, Mode=OneWay}" Command="{Binding ShowWeekCommand}"/>
                                <RadioButton Style="{StaticResource SegmentOption}" GroupName="calMode" Padding="14,5" Content="Agenda"
                                             IsChecked="{Binding IsAgendaMode, Mode=OneWay}" Command="{Binding ShowAgendaCommand}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ShowCalendarNav, Converter={StaticResource BoolToVis}}">
                            <Button Style="{StaticResource IconButton}" Command="{Binding CalendarPrevCommand}" Margin="12,0,0,0" Padding="8"
                                    ToolTip="Previous">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronLeft}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Content="Today" Margin="6,0,0,0" Command="{Binding CalendarTodayCommand}"/>
                            <Button Style="{StaticResource IconButton}" Command="{Binding CalendarNextCommand}" Margin="6,0,0,0" Padding="8"
                                    ToolTip="Next">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- New -->
                    <Button Style="{StaticResource IconGhost}" Command="{Binding MarkAllSeenCommand}"
                            ToolTip="Clear every NEW mark of this term"
                            Visibility="{Binding ShowMarkAllNew, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}" Width="12" Height="12" Stretch="Uniform"/>
                            <TextBlock Text="Mark all seen" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" Padding="8"
                            ToolTip="Refresh from Canvas"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" svc:SmoothScroll.Enabled="True"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PanningDeceleration="0.0015"
                          CanContentScroll="False" Stylus.IsFlicksEnabled="False">
                <StackPanel Margin="0,0,10,72">

                    <!-- token rejected / offline -->
                    <Border CornerRadius="14" BorderThickness="1" Padding="16,12" Margin="0,0,0,16"
                            Background="{DynamicResource App.AccentSoftBrush}" BorderBrush="{DynamicResource App.StrokeBrush}"
                            Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6" VerticalAlignment="Center"
                                    Command="{Binding DismissBannerCommand}" ToolTip="Dismiss">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open settings" Margin="12,0,6,0"
                                    VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}"
                                    Visibility="{Binding BannerOffersSettings, Converter={StaticResource BoolToVis}}"/>
                            <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}"
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Banner}" Style="{StaticResource Body}" TextWrapping="Wrap" TextTrimming="None"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- ============================ not connected ============================ -->
                    <Border Style="{StaticResource GlassCard}" Padding="26,24" Margin="0,0,0,28" MaxWidth="640"
                            HorizontalAlignment="Left"
                            Visibility="{Binding IsConnectPage, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Your courses, without the Canvas website" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextBrush}"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,6,0,14"
                                       Text="Graphite shows every course's start page and modules, with all their files (also the ones hidden from the Files tab), and opens a file in a tab with one click. It only reads from Canvas: nothing is posted, nothing is downloaded until you click."/>
                            <TextBlock Text="To connect, create an access token in Canvas:" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,16"
                                       LineHeight="20">
                                <Run Text="1.  Open Canvas, then Account › Settings."/><LineBreak/>
                                <Run Text="2.  Under Approved Integrations, click + New Access Token (+ Neues Zugangs-Token)."/><LineBreak/>
                                <Run Text="3.  Name it, choose an expiry date, and copy the token. Canvas shows it only once."/>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Paste the token in Settings…"
                                        Command="{Binding OpenSettingsCommand}"/>
                                <Button Style="{StaticResource GhostButton}" Content="Open Canvas" Margin="10,0,0,0"
                                        Command="{Binding OpenInCanvasCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ============================ overview ============================ -->
                    <StackPanel Visibility="{Binding IsOverview, Converter={StaticResource BoolToVis}}">
                        <!-- nothing new: the day at a glance -->
                        <StackPanel Margin="0,0,0,16" Visibility="{Binding HasCalendarStrip, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="4,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open calendar →"
                                        FontSize="11.5" Padding="8,2" Command="{Binding ShowCalendarCommand}"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Coming up" FontWeight="SemiBold" FontSize="14"/>
                                </TextBlock>
                            </DockPanel>
                            <!-- one row of cards, all as high as the tallest (the day's timetable shows in full) -->
                            <ItemsControl ItemsSource="{Binding CalendarStrip}" ItemTemplate="{StaticResource StripCardTemplate}"
                                          Focusable="False" Margin="0,0,-14,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="All courses" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" Margin="4,4,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="NewStrip" Margin="0,0,0,16" Visibility="{Binding HasNewPreview, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="4,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Mark all seen"
                                        FontSize="11.5" Padding="8,2" Margin="6,0,0,0" Click="NewStripSeen_Click"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show all →"
                                        FontSize="11.5" Padding="8,2" Command="{Binding ShowNewCommand}"/>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="New since you last looked" FontWeight="SemiBold" FontSize="14"/>
                                    <Run Text="{Binding NewPreviewSummary, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                </TextBlock>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding NewPreview}" ItemTemplate="{StaticResource NewCardTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding NewPreviewMore}" Style="{StaticResource Caption}" Margin="6,2,0,0"/>
                            <TextBlock Text="All courses" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14" Margin="4,18,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Courses}" ItemTemplate="{StaticResource CourseCardTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,48,0,0"
                                   Visibility="{Binding Courses.Count, Converter={StaticResource ZeroToVis}}"/>
                    </StackPanel>

                    <!-- ============================ calendar ============================ -->
                    <StackPanel Visibility="{Binding IsCalendarPage, Converter={StaticResource BoolToVis}}">

                        <!-- something went wrong with a calendar link or the deadlines -->
                        <Border CornerRadius="12" BorderThickness="1" Padding="14,10" Margin="0,0,0,12"
                                Background="{DynamicResource App.AccentSoftBrush}" BorderBrush="{DynamicResource App.StrokeBrush}"
                                Visibility="{Binding HasCalendarMessage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CalendarMessage}" Style="{StaticResource Body}" TextWrapping="Wrap" TextTrimming="None"/>
                        </Border>

                        <!-- ===== month ===== -->
                        <Grid Style="{StaticResource CalViewIn}" Visibility="{Binding IsMonthMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <UniformGrid Columns="7" Margin="3,0,3,4">
                                    <TextBlock Text="MON" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="TUE" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="WED" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="THU" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="FRI" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="SAT" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                    <TextBlock Text="SUN" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource Cal.MutedTextBrush}" Margin="8,0,0,0"/>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding MonthDays}" ItemTemplate="{StaticResource MonthCellTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="300" Margin="16,0,0,0">
                                <!-- the selected day -->
                                <Border Style="{StaticResource GlassCard}" Padding="20,18,20,8" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DayPanelLabel}" Style="{StaticResource SectionLabel}"/>
                                        <TextBlock Text="{Binding DayPanelTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource App.TextBrush}" Margin="0,4,0,16"/>
                                        <ItemsControl ItemsSource="{Binding DayEntries}" ItemTemplate="{StaticResource DayEntryTemplate}" Focusable="False"/>
                                        <TextBlock Text="Nothing on this day." Style="{StaticResource Caption}" FontSize="12.5" Margin="0,0,0,12"
                                                   Visibility="{Binding DayPanelEmpty, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- what to show, and where it comes from -->
                                <Border Style="{StaticResource GlassCard}" Padding="20,16" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="SHOW ON THE CALENDAR" Style="{StaticResource SectionLabel}" Margin="0,0,0,12"/>
                                        <DockPanel Margin="0,0,0,12">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding ShowDueDates, Mode=TwoWay}" AutomationProperties.Name="Canvas due dates"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Canvas due dates" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource App.TextBrush}"/>
                                                <TextBlock Text="Assignments and quizzes of your courses" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" TextTrimming="None"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel>
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding ShowLectures, Mode=TwoWay}" AutomationProperties.Name="Lectures and exams"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Lectures and exams" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource App.TextBrush}"/>
                                                <TextBlock Text="From the calendar links you added" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" TextTrimming="None"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Margin="0,12,0,0">
                                            <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}" VerticalAlignment="Center"
                                                          IsChecked="{Binding ShowAllDay, Mode=TwoWay}" AutomationProperties.Name="All-day events"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="All-day events" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource App.TextBrush}"/>
                                                <TextBlock Text="Semester dates, registration phases …" Style="{StaticResource Caption}"
                                                           TextWrapping="Wrap" TextTrimming="None"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="0,16,0,14"/>

                                        <ItemsControl ItemsSource="{Binding CalendarSourceRows}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:CalendarSourceRow}">
                                                    <StackPanel Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No calendar linked yet. Add one to see your lectures here." Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,8"
                                                   Visibility="{Binding HasCalendarSources, Converter={StaticResource InvBoolToVis}}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Add calendar…" Command="{Binding AddCalendarCommand}"/>
                                            <Button Style="{StaticResource GhostButton}" Content="Sync now" Margin="8,0,0,0" Command="{Binding SyncCalendarCommand}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,14,0,0"
                                                   Text="Graphite only reads: Canvas for deadlines, and the calendar links you pick for lectures and exams. Links are managed in Settings."/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.LectureBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lecture" Style="{StaticResource Caption}" Margin="6,0,14,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.DueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Due" Style="{StaticResource Caption}" Margin="6,0,14,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.ExamBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exam" Style="{StaticResource Caption}" Margin="6,0,14,0"/>
                                    <TextBlock Text="Bar colour = course" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ===== week ===== (the hour height of 58 px is HourHeight in CanvasViewModel.Calendar.cs) -->
                        <Border Style="{StaticResource CalGlassIn}" Padding="0,14,12,12"
                                Visibility="{Binding IsWeekMode, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ItemsControl Grid.Row="0" Grid.Column="1" ItemsSource="{Binding WeekDays}"
                                              ItemTemplate="{StaticResource WeekHeaderTemplate}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- hour labels -->
                                <ItemsControl Grid.Row="1" Grid.Column="0" ItemsSource="{Binding WeekHours}" Focusable="False" IsHitTestVisible="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CalendarHourVm}">
                                            <Border Height="58">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Top" Margin="0,-8,10,0"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Grid.Row="1" Grid.Column="1">
                                    <!-- hour lines -->
                                    <ItemsControl ItemsSource="{Binding WeekHours}" Focusable="False" IsHitTestVisible="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CalendarHourVm}">
                                                <Border Height="58" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource App.StrokeSoftBrush}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- the seven days -->
                                    <ItemsControl ItemsSource="{Binding WeekDays}" ItemTemplate="{StaticResource WeekColumnTemplate}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <!-- now -->
                                    <Border Height="2" CornerRadius="1" VerticalAlignment="Top" IsHitTestVisible="False"
                                            Background="{StaticResource Cal.ExamBrush}" Margin="{Binding NowLineMargin}"
                                            Visibility="{Binding ShowNowLine, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ===== agenda ===== -->
                        <Grid Style="{StaticResource CalViewIn}" Visibility="{Binding IsAgendaMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,14">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CalendarStatus}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                                    <Border Style="{StaticResource SegmentTray}" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource SegmentOption}" GroupName="calFilter" Padding="14,5" Content="All"
                                                         IsChecked="{Binding AgendaAll, Mode=OneWay}"
                                                         Command="{Binding SetAgendaFilterCommand}" CommandParameter="All"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" GroupName="calFilter" Padding="14,5" Content="Deadlines"
                                                         IsChecked="{Binding AgendaDeadlines, Mode=OneWay}"
                                                         Command="{Binding SetAgendaFilterCommand}" CommandParameter="Deadline"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" GroupName="calFilter" Padding="14,5" Content="Lectures"
                                                         IsChecked="{Binding AgendaLectures, Mode=OneWay}"
                                                         Command="{Binding SetAgendaFilterCommand}" CommandParameter="Lecture"/>
                                            <RadioButton Style="{StaticResource SegmentOption}" GroupName="calFilter" Padding="14,5" Content="Exams"
                                                         IsChecked="{Binding AgendaExams, Mode=OneWay}"
                                                         Command="{Binding SetAgendaFilterCommand}" CommandParameter="Exam"/>
                                        </StackPanel>
                                    </Border>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding AgendaGroups}" ItemTemplate="{StaticResource AgendaGroupTemplate}" Focusable="False"/>
                                <TextBlock Text="Nothing in the next 14 days." Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                                           Margin="0,48,0,0" Visibility="{Binding AgendaGroups.Count, Converter={StaticResource ZeroToVis}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="300" Margin="16,0,0,0">
                                <Border Style="{StaticResource GlassCard}" Padding="16,14,16,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MiniTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource App.TextBrush}"
                                                   Margin="0,0,0,8"/>
                                        <UniformGrid Columns="7" Margin="0,0,0,2">
                                            <TextBlock Text="M" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="W" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="T" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="F" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="S" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                                        </UniformGrid>
                                        <ItemsControl ItemsSource="{Binding MiniDays}" ItemTemplate="{StaticResource MiniDayTemplate}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="7"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="8,10,0,0">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.LectureBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Lecture" Style="{StaticResource Caption}" Margin="6,0,12,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.DueBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Due" Style="{StaticResource Caption}" Margin="6,0,12,0"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource Cal.ExamBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Exam" Style="{StaticResource Caption}" Margin="6,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ============================ New / Pinned / search ============================ -->
                    <StackPanel Visibility="{Binding ShowSections, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False"/>
                        <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,48,0,0" MaxWidth="520"
                                   Visibility="{Binding Sections.Count, Converter={StaticResource ZeroToVis}}"/>
                    </StackPanel>

                    <!-- ============================ a course ============================ -->
                    <StackPanel Visibility="{Binding IsCoursePage, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="14" BorderThickness="1" Padding="16,12" Margin="0,0,0,16"
                                BorderBrush="{DynamicResource App.StrokeBrush}"
                                Visibility="{Binding CourseError, Converter={StaticResource NullToVis}}">
                            <DockPanel>
                                <Path DockPanel.Dock="Left" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Warning}"
                                      Width="16" Height="16" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CourseError}" Style="{StaticResource Body}" TextWrapping="Wrap"
                                           TextTrimming="None" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- loading for the first time: the shape of a few modules, still -->
                        <StackPanel Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Loading the modules…" Style="{StaticResource Caption}" Margin="4,0,0,10"/>
                            <Border Style="{StaticResource RowCard}" Padding="16,14">
                                <StackPanel>
                                    <Border Height="12" Width="180" HorizontalAlignment="Left" CornerRadius="6"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="320" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,16,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="260" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,12,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}" Padding="16,14">
                                <StackPanel>
                                    <Border Height="12" Width="240" HorizontalAlignment="Left" CornerRadius="6"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="320" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,16,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="260" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,12,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource RowCard}" Padding="16,14">
                                <StackPanel>
                                    <Border Height="12" Width="150" HorizontalAlignment="Left" CornerRadius="6"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="320" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,16,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                    <Border Height="9" Width="260" HorizontalAlignment="Left" CornerRadius="4.5" Margin="0,12,0,0"
                                            Background="{DynamicResource App.HoverBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- pinned in this course -->
                        <StackPanel Visibility="{Binding HasCoursePins, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="PINNED" Style="{StaticResource SectionLabel}" Margin="4,0,0,8"/>
                            <Border Style="{StaticResource RowCard}" Margin="0,0,0,22">
                                <ItemsControl ItemsSource="{Binding CoursePins}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                            </Border>
                        </StackPanel>

                        <!-- the start page: its text laid out as a page, then the files and links it points to -->
                        <StackPanel Visibility="{Binding HasFront, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="4,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconGhost}" Margin="0"
                                        Command="{Binding OpenFrontPageCommand}" ToolTip="Open this page in your browser"
                                        Visibility="{Binding HasFrontBody, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}" Width="11" Height="11"
                                              Stretch="Uniform"/>
                                        <TextBlock Text="Open in browser" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="START PAGE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <!-- the page itself -->
                            <Border Style="{StaticResource RowCard}" Margin="0,0,0,12" Padding="24,20,24,12"
                                    Visibility="{Binding HasFrontBody, Converter={StaticResource BoolToVis}}">
                                <ctrl:CanvasPageView x:Name="FrontPage" Blocks="{Binding FrontBlocks}" MaxWidth="780"
                                                     HorizontalAlignment="Left"/>
                            </Border>

                            <!-- no text to show (an old cache, an empty page): a row that opens it in the browser -->
                            <Border Style="{StaticResource RowCard}" Margin="0,0,0,22"
                                    Visibility="{Binding HasFrontBody, Converter={StaticResource InvBoolToVis}}">
                                <Button Style="{StaticResource RailRow}" MinHeight="38" Padding="8,0,6,0"
                                        Command="{Binding OpenFrontPageCommand}" ToolTip="Open in your browser">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}"
                                              Width="12" Height="12" Stretch="Uniform" Margin="8,0,7,0" Opacity="0.7"/>
                                        <Border Style="{StaticResource TypeBadge}">
                                            <TextBlock Text="PAGE" Style="{StaticResource TypeBadgeText}"/>
                                        </Border>
                                        <TextBlock Text="{Binding FrontTitle}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Button>
                            </Border>

                            <!-- what the page links to: the same rows as everywhere, to open or download -->
                            <StackPanel Visibility="{Binding HasFrontLinks, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Files and links on this page" Style="{StaticResource Caption}" Margin="6,0,0,6"/>
                                <Border Style="{StaticResource RowCard}" Margin="0,0,0,22">
                                    <ItemsControl ItemsSource="{Binding FrontLinks}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                                </Border>
                            </StackPanel>
                            <Rectangle Height="10" Visibility="{Binding HasFrontLinks, Converter={StaticResource InvBoolToVis}}"/>
                        </StackPanel>

                        <TextBlock Text="MODULES" Style="{StaticResource SectionLabel}" Margin="4,0,0,8"
                                   Visibility="{Binding HasModules, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl x:Name="ModulesList" ItemsSource="{Binding Modules}" ItemTemplate="{StaticResource ModuleTemplate}" Focusable="False"/>
                        <TextBlock Text="This course has no modules." Style="{StaticResource Caption}" FontSize="13"
                                   TextAlignment="Center" Margin="0,40,0,0"
                                   Visibility="{Binding ShowNoModules, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- while a wheel glide runs this takes the pointer, so the rows underneath stay still (SmoothScroll.Shield) -->
            <Border x:Name="GlideShield" Grid.Row="1" Background="Transparent" IsHitTestVisible="False"/>
        </Grid>

        <!-- download finished, saved to …: a pill floating at the bottom, like the page bar -->
        <Border Style="{StaticResource GlassPill}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                Padding="16,6,6,6" MaxWidth="620" Background="{DynamicResource App.FloatingBrush}"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="7" VerticalAlignment="Center"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" Width="9" Height="9" Stretch="Uniform"/>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show in folder" Margin="12,0,4,0"
                        VerticalAlignment="Center" Command="{Binding RevealNoticeCommand}"
                        Visibility="{Binding HasNoticeFolder, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Notice}" Style="{StaticResource Body}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
