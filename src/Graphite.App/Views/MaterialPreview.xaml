<UserControl x:Class="Graphite.App.Views.MaterialPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="196" Height="118" Focusable="False" IsHitTestVisible="False">

    <!-- A tiny stand-in for the window: a wallpaper, the material's tint over it, then a command bar,
         a side panel and a page area drawn with the material's own brushes. The brushes come from
         the material's dictionary, which MaterialPreview.xaml.cs merges into this control's
         resources (so each card shows its own material, whichever one is active). -->
    <Grid>
        <Grid.Clip>
            <RectangleGeometry Rect="0,0,196,118" RadiusX="10" RadiusY="10"/>
        </Grid.Clip>

        <!-- desktop wallpaper stand-in; oversized so the blur has no transparent edge -->
        <Grid x:Name="Wallpaper" Margin="-36">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#9333EA" Offset="0.55"/>
                    <GradientStop Color="#F97316" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="110" Height="110" Fill="#FDE047" Opacity="0.85"
                     HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
            <Ellipse Width="96" Height="96" Fill="#22D3EE" Opacity="0.85"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,24,0"/>
        </Grid>

        <!-- what the Windows backdrop adds on top of the wallpaper -->
        <Border x:Name="Tint" Background="{DynamicResource App.BackgroundBrush}" Opacity="0.6"/>

        <!-- the mini window -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- command bar -->
            <Border CornerRadius="7" BorderThickness="1"
                    Background="{DynamicResource App.GlassBrush}" BorderBrush="{DynamicResource App.GlassBorderBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource App.BrandBlueBrush}"/>
                    <Rectangle Width="28" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="8,0,0,0"
                               Fill="{DynamicResource App.TextSecondaryBrush}" Opacity="0.7"/>
                    <Rectangle Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Margin="6,0,0,0"
                               Fill="{DynamicResource App.TextSecondaryBrush}" Opacity="0.45"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- side panel -->
                <Border CornerRadius="7" BorderThickness="1"
                        Background="{DynamicResource App.PanelBrush}" BorderBrush="{DynamicResource App.GlassBorderBrush}">
                    <StackPanel Margin="7,9,7,0">
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource App.TextBrush}" Opacity="0.65"/>
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,6,10,0" Fill="{DynamicResource App.TextSecondaryBrush}" Opacity="0.55"/>
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,6,4,0" Fill="{DynamicResource App.TextSecondaryBrush}" Opacity="0.55"/>
                    </StackPanel>
                </Border>

                <!-- page area with a sheet of paper -->
                <Border Grid.Column="2" CornerRadius="7" BorderThickness="1"
                        Background="{DynamicResource App.ViewerBrush}" BorderBrush="{DynamicResource App.GlassBorderBrush}">
                    <Border Width="58" Margin="0,9,0,0" VerticalAlignment="Top" HorizontalAlignment="Center"
                            Height="64" CornerRadius="3" Background="#F8F8F6">
                        <StackPanel Margin="7,8,7,0">
                            <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#B9BDC4"/>
                            <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,5,8,0" Fill="#D3D7DD"/>
                            <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,5,0,0" Fill="#D3D7DD"/>
                            <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Margin="0,5,14,0" Fill="#D3D7DD"/>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
