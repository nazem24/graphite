<UserControl x:Class="Graphite.App.Views.LibraryHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graphite.App.ViewModels"
             xmlns:ctrl="clr-namespace:Graphite.App.Controls"
             xmlns:conv="clr-namespace:Graphite.App.Converters"
             Focusable="False">

    <!-- DataContext: LibraryViewModel (set by MainWindow). Commands that live on it are reached
         from inside item templates through DataContext of the nearest UserControl. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>

        <!-- Faint text lines drawn on a blank sheet of paper while a preview is loading. -->
        <DrawingBrush x:Key="PaperLines" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,100,5"
                      ViewboxUnits="Absolute" Viewbox="0,0,100,5">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D3D7DD">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,1.7,100,1.3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Right-click / "…" menu of a file card. DataContext is set when it opens. -->
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Header="Open" Click="CardMenu_Open"/>
            <MenuItem Header="Open in new tab" Click="CardMenu_OpenInBackground"/>
            <Separator/>
            <MenuItem Header="{Binding PinMenuText}" Click="CardMenu_Pin"/>
            <MenuItem Header="Show in Explorer" Click="CardMenu_Reveal"/>
            <MenuItem Header="Copy path" Click="CardMenu_CopyPath"/>
        </ContextMenu>

        <!-- ============================ a document, grid view ============================ -->
        <DataTemplate x:Key="FileCardTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button x:Name="Card" Style="{StaticResource LibCard}" Width="222" Height="238" Margin="0,0,12,12"
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}" ToolTip="{Binding Path}"
                    ContextMenu="{StaticResource FileMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    Loaded="FileCard_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- preview area -->
                    <Grid Grid.Row="0">
                        <!-- first page (or a blank sheet / extension while it loads) -->
                        <Border Background="White" CornerRadius="3" MinWidth="98" MinHeight="124" MaxHeight="130"
                                MaxWidth="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#40000000"
                                Visibility="{Binding OnlineOnly, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Rectangle Fill="{StaticResource PaperLines}" Margin="14,18,14,16"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}"/>
                                <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="#8A8F98" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowExtension, Converter={StaticResource BoolToVis}}"/>
                                <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="130" MaxWidth="180"/>
                            </Grid>
                        </Border>

                        <!-- OneDrive "online only": a placeholder, not a preview, so browsing never downloads -->
                        <Grid Width="104" Height="126" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding OnlineOnly, Converter={StaticResource BoolToVis}}">
                            <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.3" StrokeDashArray="3 3"
                                       Stroke="{DynamicResource App.TextSecondaryBrush}" Opacity="0.7"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}"
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="Online only" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- hover actions -->
                        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed">
                            <Button Style="{StaticResource CardCornerButton}" ToolTip="Open in new tab"
                                    Click="CardOpenInBackground_Click">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource CardCornerButton}" ToolTip="More" Margin="6,0,0,0"
                                    Click="CardMore_Click">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- pin: top left; shows on hover, stays (filled) while pinned -->
                        <Button x:Name="PinBtn" Style="{StaticResource CardCornerButton}" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="10,10,0,0" Visibility="Collapsed"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}" ToolTip="{Binding PinMenuText}">
                            <Path Width="13" Height="13" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Pin}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource App.AccentSystemBrush}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource App.AccentSystemBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- where you stopped -->
                        <Grid Height="3" VerticalAlignment="Bottom" Background="{DynamicResource App.StrokeBrush}"
                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressDone}"/>
                                <ColumnDefinition Width="{Binding ProgressRest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource App.AccentSystemBrush}"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="14,10,14,10">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   FontSize="12.5"/>
                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="PinBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================ a document, list view ============================ -->
        <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button Style="{StaticResource LibCard}" Height="50" Margin="0,0,0,6"
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}" ToolTip="{Binding Path}"
                    ContextMenu="{StaticResource FileMenu}" ContextMenuOpening="Card_ContextMenuOpening">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="28" Background="White" CornerRadius="2" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource PaperLines}" Margin="4,6,4,5"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FolderName}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding InfoText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="3" Text="{Binding WhenText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button Grid.Column="4" Style="{StaticResource CardCornerButton}" ToolTip="More" Click="CardMore_Click">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ a folder, home card ============================ -->
        <DataTemplate x:Key="FolderCardTemplate" DataType="{x:Type vm:FolderCardViewModel}">
            <Button Style="{StaticResource LibCard}" Width="296" Height="142" Margin="0,0,12,12"
                    Command="{Binding DataContext.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}" ToolTip="{Binding Path}" Loaded="FolderCard_Loaded">
                <Grid ClipToBounds="True">
                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource App.HoverBrush}"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,16,0,0">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="16" Height="16"
                              Stretch="Uniform"/>
                    </Border>

                    <!-- a stack of pages: the newest PDF's first page sits on top -->
                    <Grid Width="124" Height="118" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,6,-6">
                        <Border Width="86" Height="104" Background="White" Opacity="0.5" CornerRadius="3"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-9"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="86" Height="106" Background="White" Opacity="0.78" CornerRadius="3"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,0"
                                RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="-4"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Width="88" Height="108" Background="White" CornerRadius="3"
                                BorderThickness="1" BorderBrush="#40000000"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform>
                                <RotateTransform Angle="3"/>
                            </Border.RenderTransform>
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{StaticResource PaperLines}" Margin="10,14,10,10"/>
                                <ctrl:FadeImage Source="{Binding Preview}" Stretch="UniformToFill"
                                                VerticalAlignment="Top" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- kept clear of the page stack on the right, so nothing sits on white paper -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,14" MaxWidth="130">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="14.5"
                                   TextWrapping="Wrap" MaxHeight="40"/>
                        <TextBlock Text="{Binding CountLine}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding ChangedText}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ a nested folder, chip ============================ -->
        <DataTemplate x:Key="FolderChipTemplate" DataType="{x:Type vm:FolderCardViewModel}">
            <Button Style="{StaticResource LibChip}" Margin="0,0,10,10" ToolTip="{Binding Path}"
                    Command="{Binding DataContext.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}">
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="15" Height="15"
                          Stretch="Uniform"/>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" Margin="9,0,0,0" MaxWidth="220"/>
                    <TextBlock Text="{Binding PdfCount}" Style="{StaticResource Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- ============================ a recent file, compact card ============================ -->
        <DataTemplate x:Key="RecentCardTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button Style="{StaticResource LibCard}" Width="296" Height="58" Margin="0,0,12,12" ToolTip="{Binding Path}"
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}">
                <Grid Margin="14,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="24" Height="30" Background="White" CornerRadius="2" VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource PaperLines}" Margin="4,6,4,5"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RecentText}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,4,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================ rail ================================ -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12,12,12,10">
            <DockPanel>
                <!-- footer: library sync state, app version, update check -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="4,0,4,10"/>
                    <DockPanel Margin="10,0,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="7"
                                VerticalAlignment="Center" Command="{Binding CheckUpdatesCommand}"
                                ToolTip="Check for updates">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                        Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="6" Height="6" Fill="#4E9C51" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Opacity="0.7"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                 Command="{Binding ShowHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Home}" Width="16" Height="16"/>
                            <TextBlock Text="Home" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsRecentActive, Mode=OneWay}"
                                 Command="{Binding ShowRecentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Clock}" Width="16" Height="16"/>
                            <TextBlock Text="Recent" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsPinnedActive, Mode=OneWay}"
                                 Command="{Binding ShowPinnedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pin}" Width="16" Height="16"/>
                            <TextBlock Text="Pinned" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="4,12,4,10"/>

                    <DockPanel Margin="10,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="5"
                                Click="LibraryMenu_Click" ToolTip="Change, add or remove library folders">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Change folder…" Command="{Binding ChooseFolderCommand}"/>
                                    <MenuItem Header="Add another folder…" Command="{Binding AddFolderCommand}"/>
                                    <MenuItem Header="Remove from library" Command="{Binding RemoveFolderCommand}"
                                              IsEnabled="{Binding HasRoot}"/>
                                    <Separator/>
                                    <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RailItems}" Focusable="False"
                                      Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RailItem}">
                                    <RadioButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                 Command="{Binding DataContext.OpenRailItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}" ToolTip="{Binding Path}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource RailNav}">
                                                <Style.Triggers>
                                                    <!-- folded: only the main folder row stays -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRoot}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                        <Grid>
                                            <!-- the library folder itself -->
                                            <DockPanel Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6"
                                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ToggleRailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Fold or unfold the subfolders">
                                                    <Grid Width="10" Height="10">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              Visibility="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              Visibility="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"/>
                                                    </Grid>
                                                </Button>
                                                <Border Width="34" Height="34" CornerRadius="10"
                                                        Background="{DynamicResource App.HoverBrush}">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}"
                                                          Width="16" Height="16" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                               MaxWidth="140"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                               Margin="0,1,0,0" MaxWidth="170"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- a subfolder / the folder's own files -->
                                            <DockPanel Margin="2,0,0,0"
                                                       Visibility="{Binding IsRoot, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                                <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Doc}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- nothing chosen yet -->
                        <Grid Margin="0,2,0,0" VerticalAlignment="Top"
                              Visibility="{Binding HasRoot, Converter={StaticResource InvBoolToVis}}">
                            <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.2" StrokeDashArray="4 4"
                                       Stroke="{DynamicResource App.StrokeBrush}"/>
                            <StackPanel Margin="16,18,16,16">
                                <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Left"
                                        Background="{DynamicResource App.HoverBrush}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"
                                          Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="No main folder yet" Style="{StaticResource Body}" FontWeight="SemiBold"
                                           FontSize="13" Margin="0,12,0,0"/>
                                <TextBlock Text="Choose a folder and its subfolders will show up here."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                           Margin="0,4,0,12"/>
                                <Button Style="{StaticResource GhostButton}" Content="Choose folder…"
                                        Command="{Binding ChooseFolderCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================ content ================================ -->
        <Grid Grid.Column="1" Margin="18,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header: where you are, search, view options -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <!-- breadcrumb: back, then every level of the path -->
                    <StackPanel Orientation="Horizontal" Margin="-4,0,0,4" Height="26"
                                Visibility="{Binding ShowBreadcrumb, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource IconButton}" Padding="6" Command="{Binding GoUpCommand}"
                                ToolTip="Back up one level" Margin="0,0,8,0">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ArrowLeft}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Breadcrumbs}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Padding="6,4"
                                                Command="{Binding DataContext.OpenCrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Path}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                        </Button>
                                        <TextBlock Text="/" VerticalAlignment="Center" Margin="1,0,1,1" Opacity="0.55"
                                                   Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                   Visibility="{Binding IsNotLast, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,2,0,0">
                    <!-- show every file type (inside a folder) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                                ToolTip="Also list images, text files and everything else. Graphite opens PDFs; Windows opens the rest."
                                Visibility="{Binding ShowTypeToggle, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowAllTypes, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        <TextBlock Text="All file types" Style="{StaticResource Body}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- sort (inside a folder) -->
                    <Button Style="{StaticResource GhostButton}" Click="SortMenu_Click" Margin="0,0,10,0"
                            Visibility="{Binding CanSort, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SortLabel}"/>
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                  Width="10" Height="10" Stretch="Uniform" Margin="7,1,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Name" Command="{Binding SetSortCommand}" CommandParameter="Name"/>
                                <MenuItem Header="Modified" Command="{Binding SetSortCommand}" CommandParameter="Modified"/>
                                <MenuItem Header="Size" Command="{Binding SetSortCommand}" CommandParameter="Size"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- search, scoped to wherever you are -->
                    <Border Width="300" Height="36" CornerRadius="18" Background="{DynamicResource App.CardBrush}"
                            BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1">
                        <Grid Margin="14,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SearchPlaceholder}" Style="{StaticResource Caption}" FontSize="12.5"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="5" ToolTip="Clear search"
                                    Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" Width="10" Height="10"
                                      Stretch="Uniform"/>
                            </Button>
                            <Border Grid.Column="2" CornerRadius="7" Padding="7,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                    Background="{DynamicResource App.HoverBrush}" IsHitTestVisible="False"
                                    Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="Ctrl F" Style="{StaticResource Caption}" FontSize="10.5"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- grid / list -->
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                Visibility="{Binding ShowFilesBody, Converter={StaticResource BoolToVis}}">
                        <RadioButton Style="{StaticResource ToolToggle}" ToolTip="Grid"
                                     IsChecked="{Binding IsGrid, Mode=OneWay}"
                                     Command="{Binding SetViewModeCommand}" CommandParameter="grid">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thumbs}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" ToolTip="List" Margin="4,0,0,0"
                                     IsChecked="{Binding IsList, Mode=OneWay}"
                                     Command="{Binding SetViewModeCommand}" CommandParameter="list">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Outline}"/>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================ home sections ============================ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowHomeSections, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,10,12">

                    <!-- continue reading + open elsewhere -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding ContinueColumnWidth}"/>
                            <ColumnDefinition Width="{Binding DropColumnWidth}"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource LibCard}" Height="124" Margin="0,0,14,0"
                                DataContext="{Binding ContinueItem}" Loaded="FileCard_Loaded" DataContextChanged="ContinueCard_DataContextChanged"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding DataContext.ShowContinue, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="18,14,18,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="3" Width="72" Height="94" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PaperLines}" Margin="9,13,9,10"
                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}"/>
                                        <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="CONTINUE READING" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                               FontSize="17" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding ContinueText}" Style="{StaticResource Caption}" FontSize="12"
                                               Margin="0,3,0,0"/>
                                    <Grid Height="4" Margin="0,12,0,0" Background="{DynamicResource App.StrokeBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ProgressDone}"/>
                                            <ColumnDefinition Width="{Binding ProgressRest}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource App.AccentSystemBrush}" CornerRadius="2"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Resume"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </Grid>
                        </Button>

                        <Grid Grid.Column="1" Height="124">
                            <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="1.3" StrokeDashArray="4 4"
                                       Stroke="{DynamicResource App.StrokeBrush}"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Drop any PDF here, or open a file from outside this library"
                                           Style="{StaticResource Caption}" FontSize="12.5" TextAlignment="Center"
                                           TextWrapping="Wrap" TextTrimming="None" MaxWidth="280"/>
                                <Button Style="{StaticResource GhostButton}" Command="{Binding OpenFileDialogCommand}"
                                        HorizontalAlignment="Center" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open file…"/>
                                        <Border CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource App.HoverBrush}">
                                            <TextBlock Text="Ctrl O" Style="{StaticResource Caption}" FontSize="10.5"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- no library yet -->
                    <Border Style="{StaticResource GlassCard}" Padding="26,24" Margin="0,0,0,28" MaxWidth="640"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasRoot, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Open your files in one click" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,6,0,16"
                                       Text="Choose one folder, usually in OneDrive. Graphite shows its subfolders and PDFs right here, so opening a file never needs a file dialog. It only reads the folder: nothing is copied or uploaded."/>
                            <Button Style="{StaticResource AccentButton}" Content="Choose folder…"
                                    Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- folders -->
                    <StackPanel Visibility="{Binding ShowFoldersSection, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="2,0,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="8,4"
                                    Click="SortMenu_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SortLabel}" Style="{StaticResource Caption}" FontSize="12"/>
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                          Width="9" Height="9" Stretch="Uniform" Margin="6,1,0,0"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Name" Command="{Binding SetSortCommand}" CommandParameter="Name"/>
                                        <MenuItem Header="Modified" Command="{Binding SetSortCommand}" CommandParameter="Modified"/>
                                        <MenuItem Header="Size (PDF count)" Command="{Binding SetSortCommand}" CommandParameter="Size"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderCardTemplate}"
                                      Focusable="False" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- recently opened -->
                    <StackPanel Visibility="{Binding HasRecents, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="RECENTLY OPENED" Style="{StaticResource SectionLabel}" Margin="2,10,0,12"/>
                        <ItemsControl ItemsSource="{Binding Recents}" ItemTemplate="{StaticResource RecentCardTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ a folder / recent / pinned / search results ============================ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowFilesBody, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,10,12">
                    <!-- nested folders as chips, above the files -->
                    <TextBlock Text="SUBFOLDERS" Style="{StaticResource SectionLabel}" Margin="2,0,0,10"
                               Visibility="{Binding ShowChips, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderChipTemplate}"
                                  Focusable="False" Margin="0,0,0,10"
                                  Visibility="{Binding ShowChips, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileCardTemplate}"
                                  Focusable="False" Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRowTemplate}"
                                  Focusable="False" Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,48,0,0"
                               Visibility="{Binding HasFiles, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
