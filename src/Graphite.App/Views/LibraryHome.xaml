<UserControl x:Class="Graphite.App.Views.LibraryHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graphite.App.ViewModels"
             xmlns:ctrl="clr-namespace:Graphite.App.Controls"
             xmlns:conv="clr-namespace:Graphite.App.Converters"
             xmlns:svc="clr-namespace:Graphite.App.Services"
             Focusable="False">

    <!-- DataContext: LibraryViewModel (set by MainWindow). Commands that live on it are reached
         from inside item templates through DataContext of the nearest UserControl. -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>

        <!-- Faint text lines drawn on a blank sheet of paper while a preview is loading. -->
        <DrawingBrush x:Key="PaperLines" TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,100,5"
                      ViewboxUnits="Absolute" Viewbox="0,0,100,5">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,100,5"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#D3D7DD">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,1.7,100,1.3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Right-click / "…" menu of a file card. DataContext is set when it opens. -->
        <ContextMenu x:Key="FileMenu" x:Shared="False">
            <MenuItem Header="Open" Click="CardMenu_Open"/>
            <MenuItem Header="Open in new tab" Click="CardMenu_OpenInBackground"/>
            <MenuItem Header="Edit in Graphite" Click="CardMenu_EditWord" Visibility="{Binding IsDocx, Converter={StaticResource BoolToVis}}"/>
            <MenuItem Header="Open as PDF" Click="CardMenu_PdfWord" Visibility="{Binding IsDocx, Converter={StaticResource BoolToVis}}"/>
            <Separator/>
            <MenuItem Header="{Binding PinMenuText}" Click="CardMenu_Pin"/>
            <MenuItem Header="Show in Explorer" Click="CardMenu_Reveal"/>
            <MenuItem Header="Copy path" Click="CardMenu_CopyPath"/>
            <Separator/>
            <MenuItem Header="Delete" InputGestureText="Del" Click="CardMenu_Delete"/>
        </ContextMenu>

        <!-- ============================ a document, grid view ============================ -->
        <DataTemplate x:Key="FileCardTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button x:Name="Card" Style="{StaticResource LibCard}" Width="222" Height="238" Margin="0,0,12,12"
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource FileMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseDown" Loaded="FileCard_Loaded">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="152"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- preview area -->
                    <Grid Grid.Row="0">
                        <!-- first page (or a blank sheet / extension while it loads) -->
                        <Border Background="White" CornerRadius="3" MinWidth="98" MinHeight="124" MaxHeight="130"
                                MaxWidth="180" HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="#40000000"
                                Visibility="{Binding OnlineOnly, Converter={StaticResource InvBoolToVis}}">
                            <Grid>
                                <Rectangle Fill="{StaticResource PaperLines}" Margin="14,18,14,16"
                                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}"/>
                                <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="#8A8F98" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowExtension, Converter={StaticResource BoolToVis}}"/>
                                <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="130" MaxWidth="180"/>
                            </Grid>
                        </Border>

                        <!-- OneDrive "online only": a placeholder, not a preview, so browsing never downloads -->
                        <Grid Width="104" Height="126" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="{Binding OnlineOnly, Converter={StaticResource BoolToVis}}">
                            <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="1.3" StrokeDashArray="3 3"
                                       Stroke="{DynamicResource App.TextSecondaryBrush}" Opacity="0.7"/>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}"
                                      Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="Online only" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Word files: hovering the preview offers two ways in -->
                        <Grid Visibility="{Binding IsDocx, Converter={StaticResource BoolToVis}}"
                              Style="{StaticResource RevealOnCardHover}">
                            <Border Background="#99080A0E" CornerRadius="13,13,0,0" Margin="1,1,1,0"
                                    IsHitTestVisible="False"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Button Style="{StaticResource CardActionPrimary}" ToolTip="Open in Graphite's editor"
                                        Command="{Binding DataContext.OpenAsEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.EditText}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Stroke="{DynamicResource App.AccentContrastBrush}"/>
                                        <TextBlock Text="Edit document" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource CardActionButton}" Margin="0,8,0,0" ToolTip="Convert to PDF and open that"
                                        Command="{Binding DataContext.OpenAsPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Doc}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                        <TextBlock Text="Open as PDF" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
    
                        <!-- hover actions -->
                        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed">
                            <Button Style="{StaticResource CardCornerButton}" ToolTip="Open in new tab"
                                    Click="CardOpenInBackground_Click">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.OpenTab}"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource CardCornerButton}" ToolTip="More" Margin="6,0,0,0"
                                    Click="CardMore_Click">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                      Width="13" Height="13" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>

                        <!-- pin: top left; shows on hover, stays (filled) while pinned -->
                        <Button x:Name="PinBtn" Style="{StaticResource CardCornerButton}" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="42,10,0,0" Visibility="Collapsed"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Path}" ToolTip="{Binding PinMenuText}">
                            <Path Width="13" Height="13" Stretch="Uniform">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
                                        <Setter Property="Data" Value="{StaticResource Icon.Pin}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource App.AccentSystemBrush}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource App.AccentSystemBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- tick box: shows on hover, and on every card once something is ticked -->
                        <ToggleButton x:Name="SelBtn" Style="{StaticResource SelectBox}" HorizontalAlignment="Left"
                                      VerticalAlignment="Top" Margin="8,9,0,0" Visibility="Collapsed"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="Select"/>

                        <!-- where you stopped -->
                        <Grid Height="3" VerticalAlignment="Bottom" Background="{DynamicResource App.StrokeBrush}"
                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding ProgressDone}"/>
                                <ColumnDefinition Width="{Binding ProgressRest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource App.AccentSystemBrush}"/>
                        </Grid>
                    </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="14,10,14,10">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                   FontSize="12.5"/>
                        <TextBlock Text="{Binding InfoText}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding WhenText}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- ticked: an accent ring around the whole card -->
                    <Border x:Name="SelRing" Grid.RowSpan="2" Margin="-1" CornerRadius="14" BorderThickness="2"
                            BorderBrush="{DynamicResource App.AccentSystemBrush}" IsHitTestVisible="False"
                            Visibility="Collapsed"/>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                    <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="PinBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="SelBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="SelBtn" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="SelRing" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter TargetName="SelBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter TargetName="PinBtn" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============================ a document, list view ============================ -->
        <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button x:Name="Row" Style="{StaticResource LibCard}" Height="50" Margin="0,0,0,6"
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource FileMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseDown">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Grid.Column="0" Style="{StaticResource SelectBox}" HorizontalAlignment="Left"
                                  VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="Select"/>
                    <Border Grid.Column="1" Width="22" Height="28" Background="White" CornerRadius="2" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Rectangle Fill="{StaticResource PaperLines}" Margin="4,6,4,5"/>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FolderName}" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding InfoText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding WhenText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,8,0" CornerRadius="10" BorderThickness="1" Padding="2"
                                Background="{DynamicResource App.GlassSolidBrush}"
                                BorderBrush="{DynamicResource App.StrokeBrush}"
                                Visibility="{Binding IsDocx, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource RevealOnCardHover}">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource SegmentButton}" Content="Edit" ToolTip="Open in Graphite's editor"
                                        Command="{Binding DataContext.OpenAsEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}"/>
                                <Rectangle Width="1" Height="14" Fill="{DynamicResource App.StrokeBrush}" Margin="1,0"/>
                                <Button Style="{StaticResource SegmentButton}" Content="PDF" ToolTip="Convert to PDF and open that"
                                        Command="{Binding DataContext.OpenAsPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Path}"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource CardCornerButton}" ToolTip="More" Click="CardMore_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <Border Grid.ColumnSpan="6" Margin="-10,0,-8,0" CornerRadius="14" BorderThickness="2"
                            BorderBrush="{DynamicResource App.AccentSystemBrush}" IsHitTestVisible="False"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ the folder shape ============================ -->

        <!-- Back of a folder with its tab, 222 x 234. One shape for every card; the colours come from the
             card's own brushes (see FolderLook), so changing a folder's colour redraws it. -->
        <Geometry x:Key="FolderBackGeometry">M 0,14 A 14,14 0 0 1 14,0 L 86,0 A 12,12 0 0 1 98,12 L 98,22 L 208,22 A 14,14 0 0 1 222,36 L 222,220 A 14,14 0 0 1 208,234 L 14,234 A 14,14 0 0 1 0,220 Z</Geometry>

        <!-- The inside of the folder gets darker toward the pocket, as if the pocket cast a shadow. -->
        <LinearGradientBrush x:Key="FolderBackShade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.22"/>
            <GradientStop Color="#52000000" Offset="0.49"/>
        </LinearGradientBrush>

        <!-- A folder: the back with its tab, three sheets of paper standing in it, and the pocket in front.
             Hovering lifts the sheets a little. DataContext is the FolderCardViewModel. -->
        <Style x:Key="FolderTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource App.TextBrush}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Grid Width="222" Height="234" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <!-- Everything that does not change while you hover is drawn once into a bitmap, so the
                                     lift below only moves pictures around instead of re-rendering shadows every frame. -->
                                <Grid x:Name="backLayer" IsHitTestVisible="False">
                                    <Grid.CacheMode>
                                        <BitmapCache/>
                                    </Grid.CacheMode>
                                    <Path x:Name="back" Data="{StaticResource FolderBackGeometry}" Fill="{Binding BackBrush}">
                                        <Path.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.25"/>
                                        </Path.Effect>
                                    </Path>
                                    <Path Data="{StaticResource FolderBackGeometry}" Fill="{StaticResource FolderBackShade}"/>
                                </Grid>

                                <!-- the sheets: two plain ones behind, the top one with its coloured bars -->
                                <Grid x:Name="papers" IsHitTestVisible="False">
                                    <Grid.CacheMode>
                                        <BitmapCache/>
                                    </Grid.CacheMode>
                                    <Grid.RenderTransform>
                                        <TranslateTransform/>
                                    </Grid.RenderTransform>
                                    <Border Width="106" Height="140" HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Margin="16,58,0,0" CornerRadius="5" RenderTransformOrigin="0.5,1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#F1F1ED" Offset="0"/>
                                                <GradientStop Color="#D2D3CF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="-4"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Width="106" Height="140" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,56,16,0" CornerRadius="5" RenderTransformOrigin="0.5,1">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#D2D3CF" Offset="0"/>
                                                <GradientStop Color="#EEEFEB" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <RotateTransform Angle="3.5"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border Width="106" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Margin="0,46,0,0" CornerRadius="5" Background="#F6F6F3">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.32"/>
                                        </Border.Effect>
                                        <Canvas>
                                            <Border Canvas.Left="9" Canvas.Top="10" Width="88" Height="14" CornerRadius="2.5"
                                                    Background="{Binding BarBrush}"/>
                                            <Rectangle Canvas.Left="9" Canvas.Top="28" Width="88" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#D2D2CE"/>
                                            <Rectangle Canvas.Left="9" Canvas.Top="34" Width="62" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#D2D2CE"/>
                                            <Border Canvas.Left="9" Canvas.Top="41" Width="88" Height="10" CornerRadius="2.5"
                                                    Background="{Binding BarLightBrush}"/>
                                            <Rectangle Canvas.Left="9" Canvas.Top="55" Width="88" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#D2D2CE"/>
                                            <Rectangle Canvas.Left="9" Canvas.Top="61" Width="62" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#D2D2CE"/>
                                        </Canvas>
                                    </Border>
                                </Grid>

                                <!-- the pocket -->
                                <Border x:Name="pocket" Height="120" VerticalAlignment="Bottom" CornerRadius="14"
                                        Background="{Binding FrontBrush}" BorderBrush="#18FFFFFF" BorderThickness="0,1,0,0"/>
                                <Border x:Name="hl" Height="120" VerticalAlignment="Bottom" CornerRadius="14"
                                        Background="#14FFFFFF" Opacity="0" IsHitTestVisible="False"/>

                                <!-- keyboard focus: an outline that follows the folder's shape -->
                                <Path x:Name="ring" Data="{StaticResource FolderBackGeometry}" Stroke="{DynamicResource App.AccentSystemBrush}"
                                      StrokeThickness="2" Opacity="0" IsHitTestVisible="False"/>

                                <ContentPresenter/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="papers" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-10" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="papers" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="hl" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.985" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.985" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One colour in the folder colour picker: a round swatch, ticked while it is the folder's colour. -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Width="30" Height="30" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="ring" Stroke="{DynamicResource App.TextBrush}" StrokeThickness="2" Opacity="0"/>
                            <Ellipse Margin="4" Fill="{Binding Brush}"/>
                            <Path x:Name="tick" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Check}"
                                  Width="12" Height="12" Stretch="Uniform" Stroke="White" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click / "…" menu of a folder card. DataContext is set when it opens. -->
        <ContextMenu x:Key="FolderMenu" x:Shared="False">
            <MenuItem Header="Open" Click="FolderMenu_Open"/>
            <MenuItem Header="Change colour…" Click="FolderMenu_Colour"/>
            <MenuItem Header="Reset colour" Click="FolderMenu_ResetColour"/>
            <Separator/>
            <MenuItem Header="Show in Explorer" Click="FolderMenu_Reveal"/>
            <MenuItem Header="Copy path" Click="FolderMenu_CopyPath"/>
        </ContextMenu>

        <!-- ============================ a folder, card ============================ -->
        <!-- Same size as a document card, so folders and documents share one grid. The shape is the
             FolderTile style; this is what is written on the pocket. -->
        <DataTemplate x:Key="FolderCardTemplate" DataType="{x:Type vm:FolderCardViewModel}">
            <Button x:Name="Tile" Style="{StaticResource FolderTile}" Width="222" Height="238" Margin="0,0,12,12"
                    Command="{Binding DataContext.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource FolderMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    MouseEnter="FolderTile_MouseEnter" MouseLeave="FolderTile_MouseLeave">
                <Grid>
                    <!-- how many files are inside -->
                    <Border Width="26" Height="26" CornerRadius="13" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,14,80" Background="{Binding BadgeBrush}"
                            Visibility="{Binding ShowBadge, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding BadgeText}" FontSize="12" FontWeight="Bold"
                                   Foreground="{Binding BadgeTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="18,0,16,16" MaxWidth="188">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontSize="17" FontWeight="Bold"
                                   Foreground="{Binding TextBrush}"/>
                        <TextBlock Text="{Binding SubText}" Style="{StaticResource Caption}" FontSize="12" FontWeight="SemiBold"
                                   Margin="0,3,0,0" Foreground="{Binding SubTextBrush}"/>
                    </StackPanel>

                    <!-- hover: the same "…" menu as right-click (colour lives in there) -->
                    <Border Style="{StaticResource RevealOnCardHover}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,0,10,0">
                        <Button Style="{StaticResource CardCornerButton}" ToolTip="More" Click="CardMore_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ a folder, list row ============================ -->
        <DataTemplate x:Key="FolderRowTemplate" DataType="{x:Type vm:FolderCardViewModel}">
            <Button x:Name="Row" Style="{StaticResource LibCard}" Height="50" Margin="0,0,0,6"
                    Command="{Binding DataContext.ShowFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource FolderMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    MouseEnter="FolderTile_MouseEnter" MouseLeave="FolderTile_MouseLeave">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- a small folder in the folder's colour -->
                    <Grid Grid.Column="1" Width="28" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Path Fill="{Binding BackBrush}" Width="28" Height="24" Stretch="None"
                              Data="M 0,4 A 3,3 0 0 1 3,1 L 9,1 A 2,2 0 0 1 11,3 L 11,4 L 25,4 A 3,3 0 0 1 28,7 L 28,21 A 3,3 0 0 1 25,24 L 3,24 A 3,3 0 0 1 0,21 Z"/>
                        <Border Width="16" Height="12" Background="#F6F6F3" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                        <Border Height="14" VerticalAlignment="Bottom" CornerRadius="4" Background="{Binding FrontBrush}"/>
                    </Grid>

                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="{Binding CountLine}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding ChangedText}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="8,0"/>
                    <Button Grid.Column="5" Style="{StaticResource CardCornerButton}" ToolTip="More" Click="CardMore_Click"
                            VerticalAlignment="Center">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- ============================ a recent file, tile ============================ -->
        <!-- Same column width as a folder card (222 + 12), so recent files line up with the folders above them:
             the first page on the left, name, where it lives and when on the right, and how far you got. -->
        <DataTemplate x:Key="RecentCardTemplate" DataType="{x:Type vm:FileCardViewModel}">
            <Button x:Name="Tile" Style="{StaticResource LibCard}" Width="222" Height="100" Margin="0,0,12,12"
                   
                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding Path}"
                    ContextMenu="{StaticResource FileMenu}" ContextMenuOpening="Card_ContextMenuOpening"
                    Loaded="FileCard_Loaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- the first page, standing on a soft shadow -->
                    <Border Margin="16,0,0,0" Width="54" Height="70" Background="White" CornerRadius="3"
                            VerticalAlignment="Center" BorderThickness="1" BorderBrush="#30000000">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid ClipToBounds="True">
                            <Rectangle Fill="{StaticResource PaperLines}" Margin="7,10,7,8"
                                       Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}"/>
                            <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" FontSize="11" Foreground="#8A8F98"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding ShowExtension, Converter={StaticResource BoolToVis}}"/>
                            <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Uniform"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold" FontSize="12.5"
                                   TextWrapping="Wrap" MaxHeight="34"/>
                        <TextBlock Text="{Binding RecentText}" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

                        <!-- how far you got -->
                        <Grid Margin="0,9,0,0" Height="12"
                              Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Height="3" VerticalAlignment="Center" Background="{DynamicResource App.StrokeBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding ProgressDone}"/>
                                    <ColumnDefinition Width="{Binding ProgressRest}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource App.AccentSystemBrush}" CornerRadius="1.5"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource Caption}"
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>

                    <!-- hover: the same "…" menu as right-click -->
                    <Border Grid.Column="1" Style="{StaticResource RevealOnCardHover}" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="0,8,8,0">
                        <Button Style="{StaticResource CardCornerButton}" ToolTip="More" Click="CardMore_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                  Width="13" Height="13" Stretch="Uniform"/>
                        </Button>
                    </Border>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="12,4,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding RailColumnWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================================ rail ================================ -->
        <!-- The column is 18 px wider than the card so the gap folds away with it. -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="12,12,12,10" Margin="0,0,18,0"
                Visibility="{Binding IsRailVisible, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <!-- footer: library sync state, app version, update check -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="4,0,4,10"/>
                    <DockPanel Margin="10,0,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="7"
                                VerticalAlignment="Center" Command="{Binding CheckUpdatesCommand}"
                                ToolTip="Check for updates">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3"
                                        Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                                <Ellipse Width="6" Height="6" Fill="#4E9C51" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" Opacity="0.7"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                 Command="{Binding ShowHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Home}" Width="16" Height="16"/>
                            <TextBlock Text="Home" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsRecentActive, Mode=OneWay}"
                                 Command="{Binding ShowRecentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Clock}" Width="16" Height="16"/>
                            <TextBlock Text="Recent" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource RailNav}" IsChecked="{Binding IsPinnedActive, Mode=OneWay}"
                                 Command="{Binding ShowPinnedCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Pin}" Width="16" Height="16"/>
                            <TextBlock Text="Pinned" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <Rectangle Height="1" Fill="{DynamicResource App.StrokeSoftBrush}" Margin="4,12,4,10"/>

                    <DockPanel Margin="10,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="5"
                                Click="LibraryMenu_Click" ToolTip="Change, add or remove library folders">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.More}"
                                  Width="14" Height="14" Stretch="Uniform"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Change folder…" Command="{Binding ChooseFolderCommand}"/>
                                    <MenuItem Header="Add another folder…" Command="{Binding AddFolderCommand}"/>
                                    <MenuItem Header="Remove from library" Command="{Binding RemoveFolderCommand}"
                                              IsEnabled="{Binding HasRoot}"/>
                                    <Separator/>
                                    <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>

                <ScrollViewer svc:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PanningDeceleration="0.0015" CanContentScroll="False" Stylus.IsFlicksEnabled="False">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding RailItems}" Focusable="False"
                                      Visibility="{Binding HasRoot, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RailItem}">
                                    <RadioButton IsChecked="{Binding IsActive, Mode=OneWay}"
                                                 Command="{Binding DataContext.OpenRailItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 CommandParameter="{Binding}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton" BasedOn="{StaticResource RailNav}">
                                                <Style.Triggers>
                                                    <!-- folded: only the main folder row stays -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRoot}" Value="False"/>
                                                            <Condition Binding="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                        <Grid>
                                            <!-- the library folder itself -->
                                            <DockPanel Visibility="{Binding IsRoot, Converter={StaticResource BoolToVis}}">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="6"
                                                        VerticalAlignment="Center" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.ToggleRailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ToolTip="Fold or unfold the subfolders">
                                                    <Grid Width="10" Height="10">
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              Visibility="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}"
                                                              Width="10" Height="10" Stretch="Uniform"
                                                              Visibility="{Binding DataContext.IsRailExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"/>
                                                    </Grid>
                                                </Button>
                                                <Border Width="34" Height="34" CornerRadius="10"
                                                        Background="{DynamicResource App.HoverBrush}">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}"
                                                          Width="16" Height="16" Stretch="Uniform"/>
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                                               MaxWidth="140"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                                               Margin="0,1,0,0" MaxWidth="170"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- a subfolder / the folder's own files -->
                                            <DockPanel Margin="2,0,0,0"
                                                       Visibility="{Binding IsRoot, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                                <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0">
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Doc}"
                                                          Stretch="Uniform"
                                                          Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- nothing chosen yet -->
                        <Grid Margin="0,2,0,0" VerticalAlignment="Top"
                              Visibility="{Binding HasRoot, Converter={StaticResource InvBoolToVis}}">
                            <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.2" StrokeDashArray="4 4"
                                       Stroke="{DynamicResource App.StrokeBrush}"/>
                            <StackPanel Margin="16,18,16,16">
                                <Border Width="36" Height="36" CornerRadius="11" HorizontalAlignment="Left"
                                        Background="{DynamicResource App.HoverBrush}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"
                                          Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <TextBlock Text="No main folder yet" Style="{StaticResource Body}" FontWeight="SemiBold"
                                           FontSize="13" Margin="0,12,0,0"/>
                                <TextBlock Text="Choose a folder and its subfolders will show up here."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                           Margin="0,4,0,12"/>
                                <Button Style="{StaticResource GhostButton}" Content="Choose folder…"
                                        Command="{Binding ChooseFolderCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================================ content ================================ -->
        <!-- PageHost clips; PageContent is the page itself: it fades out, is swapped while invisible, then slides and
             fades back in when you change folder.
             See LibraryHome.xaml.cs (page transition). -->
        <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">
          <Grid x:Name="PageContent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header. Home: clock, greeting and date. Everywhere else: where you are
                 (breadcrumb, title) and the "all file types" switch. Search, sort and
                 grid/list live in the command bar. -->
            <Grid Grid.Row="0" Margin="0,4,0,16">
                <!-- start screen: clock | greeting on the left, the three "make or bring in" actions
                     in one glass pill pushed to the right edge. They share a row while there is room;
                     LibraryHome.xaml.cs drops the pill underneath (and, in a very narrow window, the
                     Viewbox shrinks it) when there is not. -->
                <Grid x:Name="HomeHeader" Margin="2,2,0,0" SizeChanged="HomeHeader_SizeChanged"
                      Visibility="{Binding ShowHomeSections, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="HomeLeft" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,0,12" SizeChanged="HomeHeader_SizeChanged">
                        <!-- clock: Apple-style semibold digits (Inter Display, bundled) with a round two-dot
                             colon in the same colour. The colon is placed in code (LibraryHome.PlaceClockColon)
                             so its centre sits on the digits' own centre. -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockHourText" Text="{Binding ClockHour}"
                                       FontFamily="/Assets/Fonts/#Graphite Clock, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                       Typography.NumeralAlignment="Tabular" FontSize="76" FontWeight="Normal"
                                       Foreground="{DynamicResource App.TextBrush}" VerticalAlignment="Top"/>
                            <StackPanel x:Name="ClockColon" VerticalAlignment="Top" Margin="4,0,4,0">
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource App.TextBrush}"/>
                                <Ellipse Width="10" Height="10" Margin="0,16,0,0" Fill="{DynamicResource App.TextBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ClockMinute}"
                                       FontFamily="/Assets/Fonts/#Graphite Clock, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI"
                                       Typography.NumeralAlignment="Tabular" FontSize="76" FontWeight="Normal"
                                       Foreground="{DynamicResource App.TextBrush}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ClockSuffix}" FontFamily="/Assets/Fonts/#Graphite Clock, Segoe UI Variable Display, Segoe UI Semibold, Segoe UI" FontSize="22" FontWeight="Normal" Margin="8,0,0,10"
                                       Foreground="{DynamicResource App.TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <Rectangle Width="1" Height="60" Margin="28,0,26,0" VerticalAlignment="Center"
                                   Fill="{DynamicResource App.StrokeSoftBrush}"/>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource App.TextBrush}"/>
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" FontSize="14"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- continue reading: a compact card at the right of the header (shrinks, or drops under the
                         greeting, when the window is narrow; LibraryHome.xaml.cs LayoutHomeHeader). -->
                    <Viewbox x:Name="HomePill" Grid.Column="2" HorizontalAlignment="Right"
                             StretchDirection="DownOnly" Stretch="Uniform" VerticalAlignment="Center"
                             Margin="0,0,0,12">
                        <Button Style="{StaticResource LibCard}" Width="340" Height="68"
                                DataContext="{Binding ContinueItem}" Loaded="FileCard_Loaded"
                                DataContextChanged="ContinueCard_DataContextChanged"
                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Visibility="{Binding DataContext.ShowContinue, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="14,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="2.5" Width="38" Height="48" VerticalAlignment="Center">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1.5" Direction="270" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Rectangle Fill="{StaticResource PaperLines}" Margin="5,8,5,6"
                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}"/>
                                        <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Continue reading" Style="{StaticResource Caption}" FontSize="11"/>
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Body}" FontWeight="SemiBold"
                                               FontSize="13" Margin="0,2,0,0"/>
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Height="4" VerticalAlignment="Center" Background="{DynamicResource App.StrokeBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{Binding ProgressDone}"/>
                                                <ColumnDefinition Width="{Binding ProgressRest}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{DynamicResource App.AccentSystemBrush}" CornerRadius="2"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource Caption}"
                                                   FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <!-- the whole card resumes; the arrow is just the hint -->
                                <Grid Grid.Column="2" Width="34" Height="34" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="{DynamicResource App.AccentSystemBrush}" Opacity="0.2"/>
                                    <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource App.AccentSystemBrush}" Opacity="0.45"/>
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ArrowRight}" Width="14" Height="14"
                                          Stretch="Uniform" Stroke="{DynamicResource App.AccentSystemBrush}"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Viewbox>
                </Grid>

                <!-- folders, recent, pinned, search results -->
                <Grid Visibility="{Binding ShowFilesBody, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- show every file type (inside a folder) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,8,0,0"
                                ToolTip="Also list images, text files and everything else. Graphite opens PDFs and its own documents; Windows opens the rest."
                                Visibility="{Binding ShowTypeToggle, Converter={StaticResource BoolToVis}}">
                        <ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding ShowAllTypes, Mode=TwoWay}"
                                      VerticalAlignment="Center"/>
                        <TextBlock Text="All file types" Style="{StaticResource Body}" Margin="9,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================ home sections ============================ -->
            <ScrollViewer svc:SmoothScroll.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PanningDeceleration="0.0015" CanContentScroll="False" Stylus.IsFlicksEnabled="False"
                          Visibility="{Binding ShowHomeSections, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,10,12">

                    <!-- the section row: "FOLDERS" and its count on the left, the New button at the far right.
                         The New card (add a PDF, blank document, new folder) opens just under the button. -->
                    <DockPanel Margin="2,0,0,14" MinHeight="34">
                        <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="NewButton" Style="{StaticResource HeroActionPrimary}" Height="34"
                                        Padding="13,0,11,0" Click="NewButton_Click" ToolTip="New">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}"
                                              Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"
                                              Stroke="{DynamicResource App.AccentContrastBrush}"/>
                                        <TextBlock Text="New" Style="{StaticResource Body}" FontSize="13" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource App.AccentContrastBrush}"/>
                                        <Path x:Name="NewChevron" Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                              Width="9" Height="9" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center"
                                              Stroke="{DynamicResource App.AccentContrastBrush}" Opacity="0.8" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform/>
                                            </Path.RenderTransform>
                                        </Path>
                                    </StackPanel>
                                </Button>

                                <!-- An opaque card that opens just under the button and grows out of it (from the button's width,
                                     anchored at its right edge); the button stays visible above it. See NewPopup_Opened. -->
                                <Popup x:Name="NewPopup" PlacementTarget="{Binding ElementName=NewButton}" Placement="Custom"
                                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="None"
                                       Opened="NewPopup_Opened" Closed="NewPopup_Closed">
                                    <Grid Width="388" Height="242">
                                        <Border x:Name="NewCard" Margin="40" Width="62" Height="8"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                CornerRadius="18" BorderThickness="1"
                                                Background="{DynamicResource App.CardBrush}"
                                                BorderBrush="{DynamicResource App.StrokeBrush}">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32"/>
                                            </Border.Effect>
                                            <Grid x:Name="NewClipHost" SizeChanged="NewClipHost_SizeChanged">
                                                <StackPanel x:Name="NewItems" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top" Width="296" Opacity="0">
                                        <Button Style="{StaticResource HeroAction}" Height="50" Command="{Binding OpenFileDialogCommand}"
                                                Click="NewItem_Click">
                                            <DockPanel Width="268">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,4,0">
                                                    <TextBlock Text="Ctrl O" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                </Border>
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Upload}" DockPanel.Dock="Left"
                                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource App.TextBrush}"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Add a PDF" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock HorizontalAlignment="Left" Text="or drop files anywhere" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0"
                                                               MaxWidth="150"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button Style="{StaticResource HeroAction}" Height="50" Command="{Binding NewDocumentCommand}"
                                                Click="NewItem_Click">
                                            <DockPanel Width="268">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,4,0">
                                                    <TextBlock Text="Ctrl N" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                </Border>
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.NewDoc}" DockPanel.Dock="Left"
                                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource App.TextBrush}"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Blank document" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock HorizontalAlignment="Left" Text="{Binding NewItemFolderName, StringFormat='In {0}'}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0"
                                                               MaxWidth="150"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                        <Button Style="{StaticResource HeroAction}" Height="50" Command="{Binding NewFolderCommand}"
                                                Click="NewItem_Click">
                                            <DockPanel Width="268">
                                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Margin="16,0,4,0">
                                                    <TextBlock Text="Ctrl Shift N" Style="{StaticResource Caption}" FontSize="10.5"/>
                                                </Border>
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.NewFolder}" DockPanel.Dock="Left"
                                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource App.TextBrush}"/>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="New folder" Style="{StaticResource Body}" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock HorizontalAlignment="Left" Text="{Binding NewItemFolderName, StringFormat='In {0}'}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0"
                                                               MaxWidth="150"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                                                                        </StackPanel>

                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Popup>
                        </Grid>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Caption}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Visibility="{Binding ShowFoldersSection, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"
                                   Visibility="{Binding ShowFoldersSection, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>

                    <!-- no library yet -->
                    <Border Style="{StaticResource GlassCard}" Padding="26,24" Margin="0,0,0,28" MaxWidth="640"
                            HorizontalAlignment="Left"
                            Visibility="{Binding HasRoot, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Open your files in one click" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12.5" TextWrapping="Wrap" TextTrimming="None"
                                       Margin="0,6,0,16"
                                       Text="Choose one folder, usually in OneDrive. Graphite shows its subfolders and PDFs right here, so opening a file never needs a file dialog. It only reads the folder: nothing is copied or uploaded."/>
                            <Button Style="{StaticResource AccentButton}" Content="Choose folder…"
                                    Command="{Binding ChooseFolderCommand}" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- folders -->
                    <StackPanel Visibility="{Binding ShowFoldersSection, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderCardTemplate}"
                                      Focusable="False" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <!-- recently opened -->
                    <StackPanel Visibility="{Binding HasRecents, Converter={StaticResource BoolToVis}}">
                        <DockPanel Margin="2,10,0,12" MinHeight="28">
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show all"
                                    ToolTip="Everything you opened lately" Command="{Binding ShowRecentCommand}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="RECENTLY OPENED" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Recents}" ItemTemplate="{StaticResource RecentCardTemplate}"
                                      Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================ a folder / recent / pinned / search results ============================ -->
            <ScrollViewer svc:SmoothScroll.Enabled="True" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" PanningDeceleration="0.0015" CanContentScroll="False" Stylus.IsFlicksEnabled="False"
                          Visibility="{Binding ShowFilesBody, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,10,12">
                    <!-- subfolders and documents together: folders first, as cards in the grid or rows in the list -->
                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False"
                                  Visibility="{Binding IsGrid, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:FolderCardViewModel}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FolderCardTemplate}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:FileCardViewModel}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileCardTemplate}"/>
                            </DataTemplate>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Entries}" Focusable="False"
                                  Visibility="{Binding IsList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:FolderCardViewModel}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FolderRowTemplate}"/>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:FileCardViewModel}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileRowTemplate}"/>
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource Caption}" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,48,0,0"
                               Visibility="{Binding HasFiles, Converter={StaticResource InvBoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
          </Grid>

            <!-- ============================ folder colour picker ============================ -->
            <!-- One picker for every folder card: opened next to the card it is for (see LibraryHome.xaml.cs). -->
            <Popup x:Name="ColorPopup" Placement="Bottom" HorizontalOffset="-16" VerticalOffset="-44"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Opened="ColorPopup_Opened">
                <Border Margin="16" Width="268" Padding="16,14,16,14" CornerRadius="16" BorderThickness="1"
                        Background="{DynamicResource App.CardBrush}" BorderBrush="{DynamicResource App.StrokeBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="FOLDER COLOUR" Style="{StaticResource SectionLabel}"/>

                        <ItemsControl x:Name="SwatchList" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:FolderSwatch}">
                                    <Button Style="{StaticResource SwatchButton}" Margin="0,0,5,5"
                                            ToolTip="{Binding Name}" Tag="{Binding Hex}" Click="Swatch_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- any colour: type a hex code -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="HexPreview" Width="22" Height="22" Stroke="{DynamicResource App.StrokeBrush}"
                                     StrokeThickness="1" VerticalAlignment="Center"/>
                            <TextBox x:Name="HexBox" Grid.Column="1" Margin="10,0,8,0" Height="30" MaxLength="7"
                                     VerticalContentAlignment="Center" ToolTip="Any colour, as a hex code like #2C6B66"
                                     TextChanged="HexBox_TextChanged" KeyDown="HexBox_KeyDown"/>
                            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Apply" Click="HexApply_Click"/>
                        </Grid>

                        <Rectangle Height="1" Margin="0,14,0,10" Fill="{DynamicResource App.StrokeBrush}"/>

                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Reset"
                                    ToolTip="Back to the default colour" Click="ColorReset_Click"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Use for all folders"
                                    ToolTip="Give every folder this colour" Click="ColorAll_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
