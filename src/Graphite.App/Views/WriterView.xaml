<UserControl x:Class="Graphite.App.Views.WriterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Graphite.App.ViewModels"
             xmlns:conv="clr-namespace:Graphite.App.Converters"
             Focusable="False">

    <!-- DataContext: WriterViewModel (the item of the window's document host). -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>

        <!-- one colour in a palette -->
        <DataTemplate x:Key="SwatchTemplate">
            <Button Width="24" Height="24" Margin="2" Background="{Binding}" Focusable="False" Cursor="Hand"
                    Click="Swatch_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" BorderThickness="1"
                                BorderBrush="{DynamicResource App.StrokeBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource App.TextBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
                                            <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================ formatting bar ============================ -->
        <Border Grid.Row="0" Style="{StaticResource GlassCard}" CornerRadius="14" Margin="12,0,12,6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.14"/>
            </Border.Effect>
            <DockPanel Margin="8,3">
                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource BarButton}" Focusable="False"
                              IsChecked="{Binding ShowOutline, Mode=TwoWay}" ToolTip="Outline||Show or hide the document outline">
                    <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Sidebar}"/>
                </ToggleButton>

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- paragraph style, font, size -->
                        <ComboBox x:Name="StyleBox" Width="116" Height="30" Margin="1,0,2,0" VerticalAlignment="Center"
                                  Focusable="False" ToolTip="Paragraph style" SelectionChanged="StyleBox_SelectionChanged"/>
                        <ComboBox x:Name="FontBox" Width="140" Height="30" Margin="2,0" VerticalAlignment="Center"
                                  Focusable="False" ToolTip="Font" SelectionChanged="FontBox_SelectionChanged"/>
                        <ComboBox x:Name="SizeBox" Width="62" Height="30" Margin="2,0,1,0" VerticalAlignment="Center"
                                  Focusable="False" ToolTip="Font size" SelectionChanged="SizeBox_SelectionChanged"/>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- character formatting -->
                        <ToggleButton x:Name="BoldBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.ToggleBold}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Bold|Ctrl B|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Bold}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="ItalicBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.ToggleItalic}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Italic|Ctrl I|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Italic}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="UnderlineBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Underline_Click" ToolTip="Underline|Ctrl U|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Underline}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="StrikeBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Strike_Click" ToolTip="Strikethrough||">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Strike}"/>
                        </ToggleButton>

                        <!-- colours -->
                        <ToggleButton x:Name="TextColorBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      ToolTip="Text colour||">
                            <Grid Width="16" Height="16">
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.TextColor}"/>
                                <Rectangle x:Name="TextColorBar" Width="12" Height="3" RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Bottom" Margin="0,0,0,-1" Fill="Black"/>
                            </Grid>
                        </ToggleButton>
                        <ToggleButton x:Name="MarkColorBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      ToolTip="Highlight||">
                            <Grid Width="16" Height="16">
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Highlighter}"/>
                                <Rectangle x:Name="MarkColorBar" Width="12" Height="3" RadiusX="1" RadiusY="1"
                                           VerticalAlignment="Bottom" Margin="0,0,0,-1" Fill="#FFF176"/>
                            </Grid>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- paragraph formatting -->
                        <ToggleButton x:Name="AlignLeftBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.AlignLeft}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Align left|Ctrl L|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.AlignLeft}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignCenterBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.AlignCenter}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Centre|Ctrl E|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.AlignCenter}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignRightBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.AlignRight}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Align right|Ctrl R|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.AlignRight}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="AlignJustifyBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.AlignJustify}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Justify|Ctrl J|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.AlignJustify}"/>
                        </ToggleButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <ToggleButton x:Name="BulletBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.ToggleBullets}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Bulleted list|Ctrl Shift L|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ListBullet}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="NumberBtn" Style="{StaticResource BarButton}" Focusable="False"
                                      Click="Format_Click"
                                      Command="{x:Static EditingCommands.ToggleNumbering}" CommandTarget="{Binding ElementName=Editor}"
                                      ToolTip="Numbered list||">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ListNumber}"/>
                        </ToggleButton>
                        <Button x:Name="SpacingBtn" Style="{StaticResource BarButton}" Focusable="False"
                                Click="Spacing_Click" ToolTip="Line spacing||">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.LineSpacing}"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Single" Tag="1" Click="SpacingItem_Click"/>
                                    <MenuItem Header="1.15" Tag="1.15" Click="SpacingItem_Click"/>
                                    <MenuItem Header="1.5" Tag="1.5" Click="SpacingItem_Click"/>
                                    <MenuItem Header="Double" Tag="2" Click="SpacingItem_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- text colour palette -->
        <Popup x:Name="TextColorPopup" PlacementTarget="{Binding ElementName=TextColorBtn}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=TextColorBtn, Mode=TwoWay}" StaysOpen="False"
               AllowsTransparency="True">
            <Border Margin="10,4,10,16" Padding="12,10" Width="226" Background="{DynamicResource App.GlassSolidBrush}"
                    BorderBrush="{DynamicResource App.GlassBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TEXT COLOUR" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                    <ItemsControl x:Name="TextSwatches" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="Automatic (black)" Margin="0,8,0,0" Focusable="False"
                            Click="TextColorAuto_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- highlight palette -->
        <Popup x:Name="MarkColorPopup" PlacementTarget="{Binding ElementName=MarkColorBtn}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=MarkColorBtn, Mode=TwoWay}" StaysOpen="False"
               AllowsTransparency="True">
            <Border Margin="10,4,10,16" Padding="12,10" Width="226" Background="{DynamicResource App.GlassSolidBrush}"
                    BorderBrush="{DynamicResource App.GlassBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="HIGHLIGHT" Style="{StaticResource SectionLabel}" Margin="2,0,0,6"/>
                    <ItemsControl x:Name="MarkSwatches" ItemTemplate="{StaticResource SwatchTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="No highlight" Margin="0,8,0,0" Focusable="False"
                            Click="MarkColorNone_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ============================ outline + page ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- outline -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Width="224" Margin="12,0,0,12" Padding="12,12,8,10"
                    Visibility="{Binding ShowOutline, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="OUTLINE" Style="{StaticResource SectionLabel}" Margin="4,0,0,10"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Margin="4,0,8,0" Text="Headings you add show up here, so you can jump around a long document."
                               Visibility="{Binding HasHeadings, Converter={StaticResource InvBoolToVis}}"/>
                    <ListBox x:Name="OutlineList" Style="{StaticResource GList}" ItemsSource="{Binding Outline}"
                             Visibility="{Binding HasHeadings, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OutlineItem}">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" FontSize="12.5"
                                           Margin="{Binding IndentMargin}" FontWeight="{Binding Weight}"
                                           Background="Transparent" Cursor="Hand" ToolTip="{Binding Text}"
                                           MouseLeftButtonUp="OutlineItem_Click"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- the sheet of paper -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="Surface" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Surface_PreviewMouseWheel" Focusable="False">
                    <Border x:Name="Sheet" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="28,12,28,96"
                            Background="White" CornerRadius="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.28"/>
                        </Border.Effect>
                        <Grid>
                            <RichTextBox x:Name="Editor" Background="White" Foreground="Black" CaretBrush="Black"
                                         BorderThickness="0" Padding="0" AcceptsTab="True" AcceptsReturn="True"
                                         IsDocumentEnabled="True" SpellCheck.IsEnabled="True"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                         SelectionBrush="{DynamicResource App.AccentSystemBrush}" SelectionOpacity="0.35"
                                         TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged"
                                         PreviewKeyDown="Editor_PreviewKeyDown"/>
                            <!-- faint marks where a printed page would end -->
                            <Canvas x:Name="PageGuides" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </ScrollViewer>

                <!-- where it lives -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,22" IsHitTestVisible="False">
                    <TextBlock Text="Autosave on" Style="{StaticResource Caption}" FontSize="11.5"/>
                    <TextBlock Text="{Binding StoredAsText}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- page · words · zoom -->
                <Border Style="{StaticResource GlassCard}" CornerRadius="18" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PageInfo" Text="Page 1 of 1" Style="{StaticResource Caption}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Rectangle Style="{StaticResource ToolSep}" Margin="12,0"/>
                        <TextBlock Text="{Binding WordCountText}" Style="{StaticResource Caption}" FontSize="12"
                                   VerticalAlignment="Center"/>
                        <Rectangle Style="{StaticResource ToolSep}" Margin="12,0"/>
                        <Button Style="{StaticResource IconButton}" Padding="6" Focusable="False" ToolTip="Zoom out"
                                Click="ZoomOut_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomOut}" Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="6,4" Focusable="False" ToolTip="Reset zoom"
                                Click="ZoomReset_Click">
                            <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Caption}" FontSize="12" MinWidth="34"
                                       TextAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Padding="6" Focusable="False" ToolTip="Zoom in"
                                Click="ZoomIn_Click">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomIn}" Width="13" Height="13"
                                  Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
