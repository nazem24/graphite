<Window x:Class="Graphite.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graphite.App.ViewModels"
        xmlns:ctrl="clr-namespace:Graphite.App.Controls"
        xmlns:views="clr-namespace:Graphite.App.Views"
        xmlns:conv="clr-namespace:Graphite.App.Converters"
        xmlns:core="clr-namespace:Graphite.Core;assembly=Graphite.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Graphite" Icon="/Assets/Graphite.ico" Width="1440" Height="900" MinWidth="960" MinHeight="560"
        Stylus.IsFlicksEnabled="False" Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False"
        WindowStyle="None"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Background="{DynamicResource App.BackgroundBrush}"
        TextElement.Foreground="{DynamicResource App.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5">

    <shell:WindowChrome.WindowChrome>
        <!-- Custom chrome: keeps the native min/max/close buttons and Aero snap/shadow,
             but suppresses the default system icon + "Graphite" caption text. Our own
             glass command bar (below) supplies the visible branding/toolbar instead;
             the reserved strip above it is just a blank, draggable caption area. -->
        <shell:WindowChrome CaptionHeight="40"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <conv:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:StringEqualsConverter x:Key="StrEquals"/>
        <conv:PlusOneConverter x:Key="PlusOne"/>
        <conv:ZoomToPercentConverter x:Key="ZoomToPercent"/>
        <conv:FileNameConverter x:Key="FileName"/>
        <conv:FileDirConverter x:Key="FileDir"/>

        <!-- ======================= document content ======================= -->
        <DataTemplate x:Key="DocTemplate" DataType="{x:Type vm:DocumentViewModel}">
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="8" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ============ left sidebar: thumbnails / outline ============ -->
                <!-- The two side panels slide in/out from code (MainWindow.AnimatePanel): width,
                     margin and opacity animate together, and the content keeps a fixed width so it
                     slides instead of reflowing. Tag + Loaded sync the initial state. -->
                <Border Grid.Column="0" Width="208" Margin="12,4,0,12" ClipToBounds="True"
                        Style="{StaticResource GlassCard}" Tag="SidebarPanel" Loaded="Panel_Loaded">
                    <DockPanel Width="206" HorizontalAlignment="Right">
                        <!-- No GroupName on the radio buttons in this template: named groups are
                             window-wide, and every open document has its own copy of this panel, so a
                             named group would let one tab's choice uncheck another tab's. Unnamed
                             radios group by parent, which is exactly the scope wanted. -->
                        <!-- Panel header: title, page count, and a thumbnails / outline switch. -->
                        <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                                <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="9" VerticalAlignment="Center"
                                        Background="{DynamicResource App.HoverBrush}">
                                    <TextBlock Text="{Binding Pages.Count}" Style="{StaticResource Caption}"/>
                                </Border>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" CornerRadius="10" Padding="2"
                                    Background="{DynamicResource App.HoverBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SideThumbs" Style="{StaticResource ToolToggle}" IsChecked="True"
                                                 Padding="6" ToolTip="Thumbnails">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thumbs}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </RadioButton>
                                    <RadioButton x:Name="SideOutline" Style="{StaticResource ToolToggle}" Margin="2,0,0,0"
                                                 Padding="6" ToolTip="Outline">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Outline}"
                                              Width="14" Height="14" Stretch="Uniform"/>
                                    </RadioButton>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid>
                            <!-- thumbnails -->
                            <ListBox Style="{StaticResource GList}" ItemContainerStyle="{StaticResource ThumbListItem}"
                                     ItemsSource="{Binding Pages}"
                                     SelectedIndex="{Binding CurrentPageIndex, Mode=OneWay}"
                                     SelectionChanged="Thumbs_SelectionChanged"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Visibility="{Binding IsChecked, ElementName=SideThumbs, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Loaded="Thumb_Loaded" DataContextChanged="Thumb_DataContextChanged"
                                                    HorizontalAlignment="Center">
                                            <Border BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1"
                                                    Background="White" CornerRadius="4" ClipToBounds="True">
                                                <ctrl:FadeImage Source="{Binding Thumbnail}" Width="140"
                                                                Height="{Binding ThumbHeight}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rotate left"
                                                              Command="{Binding Path=DataContext.RotatePageLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Rotate right"
                                                              Command="{Binding Path=DataContext.RotatePageRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Move up"
                                                              Command="{Binding Path=DataContext.MovePageUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move down"
                                                              Command="{Binding Path=DataContext.MovePageDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete page"
                                                              Command="{Binding Path=DataContext.DeletePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- outline -->
                            <Grid Visibility="{Binding IsChecked, ElementName=SideOutline, Converter={StaticResource BoolToVis}}">
                                <TreeView ItemsSource="{Binding Outline}" Margin="4"
                                          SelectedItemChanged="Outline_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type core:OutlineNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" Margin="0,2"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <TextBlock Text="No outline in this document" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                                           Visibility="{Binding Outline.Count, Converter={StaticResource ZeroToVis}}"/>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ============ page viewer ============ -->
                <Border Grid.Column="1" Margin="12,4,12,12" CornerRadius="16"
                        Background="{DynamicResource App.ViewerBrush}">
                    <Grid>
                        <ListBox x:Name="PagesHost"
                                 ItemsSource="{Binding VisiblePages}"
                                 Loaded="PagesHost_Loaded" DataContextChanged="PagesHost_DataContextChanged"
                                 ScrollViewer.ScrollChanged="PagesHost_ScrollChanged"
                                 PreviewMouseWheel="PagesHost_PreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="PagesHost_PreviewMouseLeftButtonDown"
                                 PreviewTouchDown="PagesHost_PreviewTouchDown"
                                 PreviewTouchMove="PagesHost_PreviewTouchMove"
                                 PreviewTouchUp="PagesHost_PreviewTouchUp"
                                 LostTouchCapture="PagesHost_LostTouchCapture"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 VirtualizingPanel.CacheLength="1,1">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource GList}">
                                    <Style.Triggers>
                                        <!-- Two-page spread lays its pair out side by side. -->
                                        <DataTrigger Binding="{Binding Layout}" Value="Spread">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Layout}" Value="Single">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6" HorizontalAlignment="Center"
                                          Loaded="PageRoot_Loaded" DataContextChanged="PageRoot_DataContextChanged">
                                        <!-- Drop shadow: three stacked translucent rectangles instead of a
                                             DropShadowEffect. A shader effect is re-run for every visible page on
                                             every frame the page moves, which is what made scrolling feel low-fps;
                                             plain rectangles cost next to nothing to move. -->
                                        <Border Margin="-6,-2,-6,-9" CornerRadius="7" Background="#0C000000" IsHitTestVisible="False"/>
                                        <Border Margin="-3,-1,-3,-5" CornerRadius="4" Background="#12000000" IsHitTestVisible="False"/>
                                        <Border Margin="-1,0,-1,-2" CornerRadius="2" Background="#1A000000" IsHitTestVisible="False"/>
                                        <Border BorderThickness="1"
                                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Doc.InvertPages}" Value="True">
                                                            <Setter Property="Background" Value="#141416"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border BorderBrush="#33000000" BorderThickness="1"
                                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <Grid>
                                                <!-- skeleton while the page bitmap is still being rendered -->
                                                <ctrl:ShimmerBorder Visibility="{Binding Image, Converter={StaticResource NullToVisInv}}"/>
                                                <!-- the cheap thumbnail stands in (blurry) until the sharp bitmap is
                                                     ready — e.g. right after switching back to a tab -->
                                                <ctrl:FadeImage Source="{Binding Thumbnail}" Stretch="Fill"
                                                                Visibility="{Binding Image, Converter={StaticResource NullToVisInv}}"/>
                                                <ctrl:FadeImage Source="{Binding Image}" Stretch="Fill"/>
                                                <ctrl:AnnotationLayer/>
                                                <!-- Inline text editing host: the Text tool drops an empty
                                                     text box and typing happens right here on the page. -->
                                                <Canvas ClipToBounds="True">
                                                    <TextBox x:Name="InlineEditor" Visibility="Collapsed"
                                                             Loaded="InlineEditor_Loaded" DataContextChanged="InlineEditor_DataContextChanged"
                                                             LostFocus="InlineEditor_LostFocus" PreviewKeyDown="InlineEditor_KeyDown"
                                                             Background="Transparent" BorderThickness="0" Padding="0"
                                                             AcceptsReturn="False" VerticalContentAlignment="Top"/>
                                                </Canvas>
                                                <!-- "you landed here" flash (jumps, history, markup cards) -->
                                                <Border x:Name="FlashRing" IsHitTestVisible="False" Opacity="0"
                                                        BorderThickness="3" BorderBrush="{DynamicResource App.AccentSystemBrush}"
                                                        Background="{DynamicResource App.AccentSoftBrush}"/>
                                                <!-- OCR: a scan line while a page is being read, a shimmer when it is done -->
                                                <Grid x:Name="OcrFx" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                                                    <Rectangle x:Name="OcrBand" Height="56" VerticalAlignment="Top">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#003E6DB5" Offset="0"/>
                                                                <GradientStop Color="#663E6DB5" Offset="0.85"/>
                                                                <GradientStop Color="#CC3E6DB5" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- floating page controls -->
                        <Border Style="{StaticResource GlassPill}" VerticalAlignment="Bottom" Tag="PageBar"
                                HorizontalAlignment="Center" Margin="0,0,0,16" Padding="7,4"
                                CornerRadius="21"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.StrokeBrush}">
                            <StackPanel Orientation="Horizontal">
                                <!-- page navigation -->
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="PrevPage_Click" ToolTip="Previous page">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronLeft}"
                                          Width="11" Height="11" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="8,4" BorderThickness="0"
                                        Command="{Binding DataContext.GoToPageDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Go to page… (Ctrl+G)">
                                    <TextBlock Text="{Binding PageStatus, NotifyOnTargetUpdated=True}" FontSize="12"
                                               Foreground="{DynamicResource App.TextBrush}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="NextPage_Click" ToolTip="Next page">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}"
                                          Width="11" Height="11" Stretch="Uniform"/>
                                </Button>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- zoom -->
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Zoom out (Ctrl+-)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomOut}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5,4" BorderThickness="0"
                                        Click="ZoomReset_Click" ToolTip="Reset zoom to 100%">
                                    <TextBlock Text="{Binding Zoom, Converter={StaticResource ZoomToPercent}}"
                                               VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource App.TextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Zoom in (Ctrl++)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomIn}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="FitWidth_Click" ToolTip="Fit width">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitWidth}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- layout -->
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6"
                                             ToolTip="Continuous"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Continuous}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Continuous}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6"
                                             ToolTip="Single page"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Single}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SinglePage}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6"
                                             ToolTip="Two pages"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Spread}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Spread}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- reading -->
                                <ToggleButton Style="{StaticResource IconButton}" Padding="6"
                                              IsChecked="{Binding InvertPages}"
                                              ToolTip="Dark pages">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Invert}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Fullscreen (F11)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Fullscreen}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Reading progress: a thin line along the bottom edge that stays put while
                             the page bar above it fades away when idle. -->
                        <ProgressBar VerticalAlignment="Bottom" Height="2" Margin="16,0,16,0"
                                     IsHitTestVisible="False" Focusable="False"
                                     Minimum="0" Maximum="{Binding Pages.Count, Mode=OneWay}"
                                     Value="{Binding CurrentPageIndex, Mode=OneWay, Converter={StaticResource PlusOne}}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track" CornerRadius="1" Background="Transparent"/>
                                        <Border x:Name="PART_Indicator" CornerRadius="1" HorizontalAlignment="Left"
                                                Background="{DynamicResource App.AccentSystemBrush}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>

                        <!-- busy overlay -->
                        <Border Background="#66000000" CornerRadius="16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="Visibility" Value="Visible">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border Background="{DynamicResource App.GlassSolidBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource PopIn}"/>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"/>
                                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Body}"
                                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ right panel: comments / search ============ -->
                <Border Grid.Column="2" Width="292" Margin="0,4,12,12" ClipToBounds="True"
                        Style="{StaticResource GlassCard}" Tag="InspectorPanel" Loaded="Panel_Loaded">
                    <DockPanel Width="290" HorizontalAlignment="Left">
                        <!-- Segmented switch: Markup (with its count) / Search. -->
                        <Border DockPanel.Dock="Top" Margin="12,10,12,8" Padding="3" CornerRadius="12"
                                Background="{DynamicResource App.HoverBrush}">
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="TabComments" Style="{StaticResource ToolToggle}" IsChecked="True"
                                             Padding="8,7" ToolTip="Markup|Highlights, notes and drawings in this document">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Note}"/>
                                        <TextBlock Text="Markup" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        <Border Margin="7,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                                                Background="{DynamicResource App.AccentSoftBrush}"
                                                Visibility="{Binding MarkupCountAll, Converter={StaticResource NonZeroToVis}}">
                                            <TextBlock Text="{Binding MarkupCountAll}" FontSize="11"
                                                       Foreground="{DynamicResource App.AccentSystemBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="TabSearch" Style="{StaticResource ToolToggle}"
                                             Padding="8,7" Loaded="SearchRadio_Loaded" ToolTip="Search|Ctrl+F|Find text in this document">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}"/>
                                        <TextBlock Text="Search" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>

                        <Grid>
                            <!-- markup: filter chips, cards grouped by page, quoted text -->
                            <Grid Visibility="{Binding IsChecked, ElementName=TabComments, Converter={StaticResource BoolToVis}}">

                                <!-- the list -->
                                <DockPanel Visibility="{Binding MarkupCountAll, Converter={StaticResource NonZeroToVis}}">
                                    <WrapPanel DockPanel.Dock="Top" Margin="14,0,8,0">
                                        <RadioButton Style="{StaticResource FilterChip}"
                                                     IsChecked="{Binding MarkupFilter, Converter={StaticResource EnumToBool}, ConverterParameter=All}">
                                            <TextBlock><Run Text="All"/> <Run Text="{Binding MarkupCountAll, Mode=OneWay}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource FilterChip}"
                                                     IsChecked="{Binding MarkupFilter, Converter={StaticResource EnumToBool}, ConverterParameter=Highlights}">
                                            <TextBlock><Run Text="Highlights"/> <Run Text="{Binding MarkupCountHighlights, Mode=OneWay}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource FilterChip}"
                                                     IsChecked="{Binding MarkupFilter, Converter={StaticResource EnumToBool}, ConverterParameter=Notes}">
                                            <TextBlock><Run Text="Notes"/> <Run Text="{Binding MarkupCountNotes, Mode=OneWay}"/></TextBlock>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource FilterChip}"
                                                     IsChecked="{Binding MarkupFilter, Converter={StaticResource EnumToBool}, ConverterParameter=Ink}">
                                            <TextBlock><Run Text="Ink"/> <Run Text="{Binding MarkupCountInk, Mode=OneWay}"/></TextBlock>
                                        </RadioButton>
                                    </WrapPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MarkupView}" Margin="10,0,10,10">
                                            <ItemsControl.GroupStyle>
                                                <GroupStyle>
                                                    <GroupStyle.ContainerStyle>
                                                        <Style TargetType="GroupItem">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="GroupItem">
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionLabel}"
                                                                                       Margin="4,10,0,6"/>
                                                                            <ItemsPresenter/>
                                                                        </StackPanel>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </GroupStyle.ContainerStyle>
                                                </GroupStyle>
                                            </ItemsControl.GroupStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource App.CardBrush}"
                                                            Tag="{Binding PulseCount, Mode=OneWay, NotifyOnTargetUpdated=True}"
                                                            BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform/>
                                                        </Border.RenderTransform>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource App.StrokeSoftBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="{DynamicResource App.AccentSystemBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <!-- Fires when the card first appears and on every click of it. -->
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <Border.InputBindings>
                                                            <MouseBinding MouseAction="LeftClick" Command="{Binding GoToCommand}"/>
                                                        </Border.InputBindings>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Ellipse Width="9" Height="9" Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                        Click="DeleteCard_Click" Padding="3" ToolTip="Delete annotation">
                                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"
                                                                          Width="10" Height="10" Stretch="Uniform"/>
                                                                </Button>
                                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Body}">
                                                                    <Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                    <Run Text=" · " Foreground="{DynamicResource App.TextSecondaryBrush}"/><Run Text="{Binding PageShort, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                                                </TextBlock>
                                                            </DockPanel>

                                                            <!-- the marked text, quoted -->
                                                            <Border Margin="0,9,0,0" Padding="10,8" CornerRadius="8"
                                                                    Background="{Binding SwatchSoft}"
                                                                    Visibility="{Binding HasQuote, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding Quote, Mode=OneWay}" TextWrapping="Wrap"
                                                                           FontSize="12.5" Foreground="{DynamicResource App.TextBrush}"/>
                                                            </Border>

                                                            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0">
                                                                <Run Text="{Binding Author, Mode=OneWay}"/> · <Run Text="{Binding When, Mode=OneWay}"/>
                                                            </TextBlock>

                                                            <Grid Margin="0,7,0,0">
                                                                <TextBox x:Name="CommentBox" Text="{Binding Contents, UpdateSourceTrigger=LostFocus}"
                                                                         TextWrapping="Wrap" AcceptsReturn="True"
                                                                         MinHeight="30" FontSize="12" ToolTip="Comment"/>
                                                                <TextBlock Text="Add a comment…" IsHitTestVisible="False" FontSize="12"
                                                                           Margin="11,7,0,0" VerticalAlignment="Top"
                                                                           Foreground="{DynamicResource App.TextSecondaryBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, ElementName=CommentBox}" Value="">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding Replies}" Margin="10,6,0,0">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{DynamicResource App.StrokeSoftBrush}"
                                                                                BorderThickness="1,0,0,0" Padding="8,2,0,4">
                                                                            <StackPanel>
                                                                                <TextBlock Style="{StaticResource Caption}">
                                                                                    <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                                </TextBlock>
                                                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"
                                                                                           TextWrapping="Wrap" FontSize="12"/>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Reply row: shown once there is a comment or a reply to answer. -->
                                                            <DockPanel Margin="10,6,0,0">
                                                                <DockPanel.Style>
                                                                    <Style TargetType="DockPanel">
                                                                        <Style.Triggers>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding Contents}" Value=""/>
                                                                                    <Condition Binding="{Binding HasReplies}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </MultiDataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </DockPanel.Style>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                        Command="{Binding AddReplyCommand}" Margin="4,0,0,0" ToolTip="Reply">
                                                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Reply}"
                                                                          Width="13" Height="13" Stretch="Uniform"/>
                                                                </Button>
                                                                <Grid>
                                                                    <TextBox x:Name="ReplyBox" Text="{Binding ReplyDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                             FontSize="12" ToolTip="Reply"/>
                                                                    <TextBlock Text="Reply…" IsHitTestVisible="False" FontSize="12"
                                                                               Margin="11,0,0,0" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource App.TextSecondaryBrush}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Text, ElementName=ReplyBox}" Value="">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Grid>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>

                                <!-- empty state: say what to do next, offer the first action, point to Ctrl K -->
                                <Grid Visibility="{Binding MarkupCountAll, Converter={StaticResource ZeroToVis}}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40">
                                        <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                                Background="{DynamicResource App.HoverBrush}">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.TextHighlight}"
                                                  Width="22" Height="22" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="No markup yet" FontSize="15" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="Pick Highlight, Pen or Text box from the toolbar. Comments and replies will collect here."
                                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource App.TextSecondaryBrush}" FontSize="12.5"/>
                                        <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                                                Command="{Binding DataContext.SetHighlightModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="text">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Start with Highlight" VerticalAlignment="Center"/>
                                                <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="5" BorderThickness="1"
                                                        Background="#14000000" BorderBrush="#33000000" VerticalAlignment="Center">
                                                    <TextBlock Text="H" FontSize="11" Foreground="{DynamicResource App.AccentContrastBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="0,0,0,18">
                                        <TextBlock Text="Tip: press" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource KeyCap}" Margin="6,0" VerticalAlignment="Center">
                                            <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                        </Border>
                                        <TextBlock Text="to search every command" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- search -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabSearch, Converter={StaticResource BoolToVis}}">
                                <StackPanel DockPanel.Dock="Top" Margin="14,2,14,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Click="SearchNext_Click" ToolTip="Next match (F3)">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Click="SearchPrev_Click" ToolTip="Previous match (Shift+F3)">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronUp}"/>
                                        </Button>
                                        <TextBox Loaded="SearchBox_Loaded" KeyDown="SearchBox_KeyDown"
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Find in document"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding MatchStatus, NotifyOnTargetUpdated=True}"
                                               Style="{StaticResource Caption}" Margin="2,6,0,0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </StackPanel>
                                <ListBox Style="{StaticResource GList}" ItemsSource="{Binding SearchResults}"
                                         SelectionChanged="Results_SelectionChanged" Margin="8,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Text="{Binding PageIndex, Converter={StaticResource PlusOne}, StringFormat={}Page {0}}"/>
                                                <TextBlock Text="{Binding Snippet}" Style="{StaticResource Body}"
                                                           TextWrapping="Wrap" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseDocumentCommand}"
                    CommandParameter="{Binding SelectedDocument}"/>
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding GoToPageDialogCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Return" Command="{Binding ShowPropertiesCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar: document tabs + caption buttons -->
            <RowDefinition Height="Auto"/>   <!-- command bar -->
            <RowDefinition Height="*"/>      <!-- document / start page -->
        </Grid.RowDefinitions>

        <!-- ======================= document tabs (title bar) ======================= -->
        <!-- Browser-style: the tabs sit in the caption strip above the command bar. Only
             the tabs themselves are click-through-to-the-app; every other pixel of the strip
             still drags the window. Right margin leaves room for the caption buttons. -->
        <Grid Grid.Row="0" Height="40" Margin="12,0,122,0"
              Visibility="{Binding IsFullscreen, Converter={StaticResource InvBoolToVis}}">
          <DockPanel>
            <!-- The start screen's tab: always first, selected while no document is. Open
                 documents stay open behind it. -->
            <RadioButton DockPanel.Dock="Left" Style="{StaticResource HomeTab}" VerticalAlignment="Center"
                         IsChecked="{Binding IsHomeSelected, Mode=OneWay}"
                         Command="{Binding GoHomeCommand}" ToolTip="Home: your library"/>
            <ListBox x:Name="TabStrip" Style="{StaticResource DocTabStrip}"
                     ItemContainerStyle="{StaticResource DocTabItem}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                     SelectionChanged="TabStrip_SelectionChanged"
                     PreviewMouseWheel="TabStrip_PreviewMouseWheel"
                     PreviewMouseDown="TabStrip_PreviewMouseDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                            <TextBlock Text="{Binding Title}" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="●" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.AccentSystemBrush}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource IconButton}" Padding="4" Margin="6,0,0,0"
                                    ToolTip="Close (Ctrl+W)"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"
                                      Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>

        <!-- ======================= floating glass command bar ======================= -->
        <!-- 32 px buttons (36 px hit area), 2 px gaps, 1 px x 20 px dividers, 9 px radius; the bar is
             about 10 px slimmer than before and nothing is added above the page. -->
        <Border x:Name="CommandBar" Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="14" Margin="12,0,12,6"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource RiseIn}"/>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <DockPanel Margin="8,3">
                <!-- brand mark -->
                <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="8,0,10,0"
                      ToolTip="Graphite">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Outer}"
                          Stroke="{DynamicResource App.TextBrush}" StrokeThickness="1.7"/>
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Inner}"
                          Stroke="{DynamicResource App.BrandBlueBrush}" StrokeThickness="1.7"/>
                </Grid>

                <!-- right side: command search, then the far-right groups (which fold into "…" when narrow) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BarSearch" Style="{StaticResource BarField}" Command="{Binding OpenPaletteCommand}"
                            Width="136" Height="30" ToolTip="Search commands|Ctrl K|Run any command from the keyboard">
                        <DockPanel>
                            <Border x:Name="BarSearchKey" DockPanel.Dock="Right" Style="{StaticResource KeyCap}" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                            </Border>
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BarSearchLabel" Text="Search" Margin="8,0,0,0" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <StackPanel x:Name="BarFarRight" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource BarButton}" IsChecked="{Binding ShowSidebar}"
                                      ToolTip="Pages panel||Show or hide thumbnails and outline">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Sidebar}"/>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource BarButton}" IsChecked="{Binding ShowInspector}"
                                      ToolTip="Markup panel||Show or hide markup and search">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Inspector}"/>
                        </ToggleButton>
                        <Button Style="{StaticResource BarButton}" Command="{Binding ToggleThemeCommand}"
                                ToolTip="Theme||Switch between light and dark">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Theme}"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform/>
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 By="150" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutSoft}"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Button>
                    </StackPanel>
                    <!-- narrow windows: the far-right groups live here instead -->
                    <Button x:Name="BarOverflow" Style="{StaticResource BarButton}" Visibility="Collapsed"
                            Click="OrganizeMenu_Click" ToolTip="More||Panels and theme">
                        <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.More}"/>
                        <Button.ContextMenu>
                            <ContextMenu MinWidth="200">
                                <MenuItem Header="Pages panel" IsCheckable="True" IsChecked="{Binding ShowSidebar, Mode=TwoWay}"/>
                                <MenuItem Header="Markup panel" IsCheckable="True" IsChecked="{Binding ShowInspector, Mode=TwoWay}"/>
                                <Separator/>
                                <MenuItem Header="Switch theme" Command="{Binding ToggleThemeCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Theme}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <!-- center: file + tools -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- File: grouped by task — open, save, print/properties, about -->
                    <Button Style="{StaticResource BarButton}" Padding="9,0" Click="OrganizeMenu_Click"
                            ToolTip="File|Ctrl+O|Open, save, print and document properties">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="FileIcon" Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Open}"/>
                            <TextBlock Text="File" Margin="7,0,0,0" FontSize="12.5" VerticalAlignment="Center"/>
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ChevronDown}"
                                  Width="10" Height="10" Stretch="Uniform" Margin="5,0,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu MinWidth="270">
                                <MenuItem Header="Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open from OneDrive" Command="{Binding OpenOneDriveCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open recent" ItemsSource="{Binding RecentFiles}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Clock}" Width="14" Height="14"/></MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding Converter={StaticResource FileName}}"/>
                                            <Setter Property="ToolTip" Value="{Binding}"/>
                                            <EventSetter Event="Click" Handler="RecentFile_Click"/>
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAs}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save encrypted copy…" Command="{Binding SaveEncryptedCopyCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Print…" InputGestureText="Ctrl+P" Command="{Binding PrintCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Print}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Document properties" InputGestureText="Alt+Enter" Command="{Binding ShowPropertiesCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Doc}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="About and updates…" Command="{Binding CheckForUpdatesCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Info}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Grid>
                    <!-- Selection pill: one shared highlight that glides to whichever tool is active
                         (MainWindow.UpdateToolPill): accent 22 % fill and a 1 px accent ring. -->
                    <Border x:Name="ToolPill" Width="32" Height="32" CornerRadius="9" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="{DynamicResource App.AccentSoftBrush}"
                            BorderBrush="{DynamicResource App.AccentSystemBrush}" BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                    </Border>
                    <!-- Hidden on the start screen (nothing to mark up yet). -->
                    <StackPanel x:Name="ToolsPanel" Orientation="Horizontal" VerticalAlignment="Center"
                                ToggleButton.Checked="Tools_CheckedChanged" ToggleButton.Unchecked="Tools_CheckedChanged">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <Button Style="{StaticResource BarButton}" Command="{Binding UndoCommand}" ToolTip="Undo|Ctrl+Z|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Undo}"/>
                        </Button>
                        <Button Style="{StaticResource BarButton}" Command="{Binding RedoCommand}" ToolTip="Redo|Ctrl+Y|">
                            <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Redo}"/>
                        </Button>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- organize menu -->
                        <Button Style="{StaticResource BarButton}" Click="OrganizeMenu_Click" ToolTip="Pages||Merge, split, insert, delete, extract and rotate">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.InsertPage}"/>
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ChevronDown}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Merge PDFs…" Command="{Binding MergeCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Merge}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Split into single pages…" Command="{Binding SplitCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Split}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Insert pages from PDF…" Command="{Binding InsertPagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.InsertPage}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Insert blank page" Command="{Binding InsertBlankPageCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete pages…" Command="{Binding DeletePagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Extract pages…" Command="{Binding ExtractPagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Extract}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Rotate page left" Command="{Binding RotatePageLeftCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateLeft}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rotate page right" Command="{Binding RotatePageRightCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateRight}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- export / convert menu (OCR lives here too) -->
                        <Button Style="{StaticResource BarButton}" Click="OrganizeMenu_Click" ToolTip="Export||Word, Excel, PowerPoint, images and text recognition">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.Export}"/>
                                <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ChevronDown}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Export to Word (.docx)…" Command="{Binding ExportWordCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export to Excel (.xlsx)…" Command="{Binding ExportExcelCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export to PowerPoint (.pptx)…" Command="{Binding ExportPowerPointCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export pages as images…" Command="{Binding ExportImagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Image}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Recognize text (OCR)…" Command="{Binding RunOcrCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Ocr}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- select + text markup -->
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Select"
                                     ToolTip="Select|V|Click markup to select it, drag to move it."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Select}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Highlight"
                                     ToolTip="Highlight|H|Drag over text to snap-highlight whole words."
                                     IsChecked="{Binding SelectedDocument.IsTextHighlightActive}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.TextHighlight}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Underline"
                                     ToolTip="Underline|U|Drag over text to underline it."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Underline}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Underline}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Strikethrough"
                                     ToolTip="Strikethrough|S|Drag over text to strike it out."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=StrikeOut}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Strike}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- pen + freehand marker + lasso + eraser -->
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Pen"
                                     ToolTip="Pen|P|Draw freehand ink."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ink}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Ink}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Marker"
                                     ToolTip="Marker|M|Draw a translucent freehand highlight."
                                     IsChecked="{Binding SelectedDocument.IsFreehandMarkerActive}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.MarkerFreehand}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Lasso"
                                     ToolTip="Lasso|L|Draw a loop to select markup, then move or delete it."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Lasso}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Eraser"
                                     ToolTip="Eraser|E|Rub out ink and marker strokes."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Eraser}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- text + shapes -->
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Text box"
                                     ToolTip="Text box|T|Click the page to type."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Text}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.TextTool}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Arrow"
                                     ToolTip="Arrow|A|Drag to draw an arrow."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Arrow}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Arrow}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Rectangle"
                                     ToolTip="Rectangle|R|Drag to draw a rectangle."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rect}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Rect}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Ellipse"
                                     ToolTip="Ellipse|O|Drag to draw an ellipse."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ellipse}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Ellipse}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- signature + content -->
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Signature"
                                     ToolTip="Signature||Stamp your saved signature. Click again to edit it."
                                     PreviewMouseLeftButtonDown="SignatureTool_PreviewMouseDown"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Signature}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Signature}"/>
                            <RadioButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit signature…" Command="{Binding EditSignatureCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Signature}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </RadioButton.ContextMenu>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Insert image"
                                     ToolTip="Insert image||Drag a box on the page to place an image."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=PlaceImage}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.Image}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource BarTool}" GroupName="Tools" AutomationProperties.Name="Edit page text"
                                     ToolTip="Edit page text||Drag over text to edit it."
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=EditText}">
                            <Path Style="{StaticResource BarToolIcon}" Data="{StaticResource Icon.EditText}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- Options for the active tool, in one popover. The chip shows the current colour. -->
                        <Border CornerRadius="11" BorderThickness="1" Margin="3,0,0,0"
                                BorderBrush="{DynamicResource App.StrokeBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="ColorToggle" Style="{StaticResource BarButton}" Margin="0"
                                              MinHeight="30" Padding="9,0"
                                              ToolTip="Tool options||Color, thickness and opacity for the active tool"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InvertBool}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="8"
                                                BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1"
                                                Background="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource HexToBrush}}"/>
                                        <Path Style="{StaticResource BarIcon}" Data="{StaticResource Icon.ChevronDown}"
                                              Width="10" Height="10" Stretch="Uniform" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="None"
                                       IsOpen="{Binding IsChecked, ElementName=ColorToggle, Mode=TwoWay}"
                                       Opened="ColorPopup_Opened">
                                    <Border x:Name="ColorCard" Margin="12,4,12,18" Padding="14,12" Width="300"
                                            CornerRadius="16" BorderThickness="1"
                                            Background="{DynamicResource App.GlassSolidBrush}"
                                            BorderBrush="{DynamicResource App.GlassBorderBrush}"
                                            RenderTransformOrigin="0.5,0">
                                        <Border.RenderTransform>
                                            <ScaleTransform/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <!-- header: tool name and its key -->
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource KeyCap}" VerticalAlignment="Center"
                                                        Visibility="{Binding SelectedDocument.ToolKey, Converter={StaticResource TipPart}, ConverterParameter=v0}">
                                                    <TextBlock Text="{Binding SelectedDocument.ToolKey}" FontSize="11"
                                                               Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedDocument.ToolTitle}" FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>

                                            <TextBlock Text="This tool has no options." Style="{StaticResource Caption}" Margin="0,10,0,2"
                                                       Visibility="{Binding SelectedDocument.HasToolOptions, Converter={StaticResource InvBoolToVis}}"/>

                                            <!-- colour: every swatch visible at once -->
                                            <StackPanel Visibility="{Binding SelectedDocument.ShowsColor, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Color" Style="{StaticResource Caption}" Margin="0,12,0,6"/>
                                                <UniformGrid Columns="5">
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#F2C744" ToolTip="Yellow"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#F2C744, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#F2C744"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#E8853C" ToolTip="Orange"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#E8853C, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#E8853C"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#C24444" ToolTip="Red"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#C24444, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#C24444"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#C75E9A" ToolTip="Pink"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#C75E9A, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#C75E9A"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#3E6DB5" ToolTip="Blue"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#3E6DB5, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#3E6DB5"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#2E8C83" ToolTip="Teal"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#2E8C83, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#2E8C83"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#4E9C51" ToolTip="Green"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#4E9C51, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#4E9C51"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#7B5EC7" ToolTip="Purple"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#7B5EC7, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#7B5EC7"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#3B3B38" ToolTip="Graphite"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#3B3B38, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#3B3B38"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#111111" ToolTip="Black"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#111111, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#111111"/>
                                                </UniformGrid>
                                            </StackPanel>

                                            <!-- thickness: shown as a real stroke -->
                                            <StackPanel Visibility="{Binding SelectedDocument.ShowsThickness, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Thickness" Style="{StaticResource Caption}" Margin="0,12,0,4"/>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=1, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Hairline" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="1" CornerRadius="0.5" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="1 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=1.5, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="1.5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Fine" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="1.5" CornerRadius="0.75" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="1.5 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=2, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Regular" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="2" CornerRadius="1.0" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="2 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=3, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Bold" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="3" CornerRadius="1.5" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="3 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=4.5, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="4.5">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Heavy" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="4.5" CornerRadius="2.25" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="4.5 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                                <RadioButton Style="{StaticResource OptionRow}"
                                                             IsChecked="{Binding SelectedDocument.ActiveStrokeWidth, Converter={StaticResource NumEquals}, ConverterParameter=6, Mode=OneWay}"
                                                             Command="{Binding SetToolWidthCommand}" CommandParameter="6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="78"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Marker" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="1" Height="6" CornerRadius="3.0" Margin="8,0,12,0"
                                                                VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/>
                                                        <TextBlock Grid.Column="2" Text="6 pt" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </RadioButton>
                                            </StackPanel>

                                            <!-- opacity -->
                                            <StackPanel Visibility="{Binding SelectedDocument.ShowsOpacity, Converter={StaticResource BoolToVis}}">
                                                <DockPanel Margin="0,14,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}"
                                                               Text="{Binding SelectedDocument.ActiveOpacityPercent}"/>
                                                    <TextBlock Text="Opacity" Style="{StaticResource Caption}"/>
                                                </DockPanel>
                                                <Slider Style="{StaticResource OpacitySlider}" Margin="0,6,0,0"
                                                        Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                        SmallChange="0.05" LargeChange="0.1"
                                                        Value="{Binding SelectedDocument.ActiveOpacity, Mode=TwoWay}"/>
                                            </StackPanel>

                                            <!-- highlight only: snap the drag to whole words -->
                                            <DockPanel Margin="0,14,0,0"
                                                       Visibility="{Binding SelectedDocument.ShowsSnap, Converter={StaticResource BoolToVis}}">
                                                <ToggleButton DockPanel.Dock="Right" Style="{StaticResource SwitchToggle}"
                                                              IsChecked="{Binding SelectedDocument.HighlightFreehand, Converter={StaticResource InvertBool}}"/>
                                                <TextBlock Text="Snap to words" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= custom caption buttons ======================= -->
        <!-- WindowChrome's built-in UseAeroCaptionButtons doesn't reliably draw anything
             on modern Windows, so minimize/maximize/close are drawn here by hand. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="40" Visibility="{Binding IsFullscreen, Converter={StaticResource InvBoolToVis}}">
            <Button Style="{StaticResource IconButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MinimizeButton_Click" ToolTip="Minimize">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.WinMinimize}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource IconButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                <Path x:Name="MaximizeRestoreIcon" Style="{StaticResource IconPath}" Data="{StaticResource Icon.WinMaximize}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click" ToolTip="Close">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
        </StackPanel>

        <!-- ======================= documents ======================= -->
        <!-- The tab strip above only selects; the documents are shown here. Every open
             document keeps its own viewer, stacked in one cell, and only the active one is
             visible. Switching tabs is therefore a visibility flip (the scroll position, the
             realized pages and their bitmaps all stay put) instead of re-pointing one shared
             viewer at a different page list, which rebuilt every page on every switch. -->
        <ItemsControl x:Name="DocHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                      ItemsSource="{Binding Documents}"
                      ItemTemplate="{StaticResource DocTemplate}"
                      Visibility="{Binding Documents.Count, Converter={StaticResource NonZeroToVis}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ItemsPresenter/>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.ItemContainerStyle>
        </ItemsControl>

        <!-- ======================= start screen (Home tab) ======================= -->
        <!-- The library: pick a folder once (OneDrive, say) and browse its subfolders and PDFs
             here. Shown whenever no document tab is selected. -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedDocument, Converter={StaticResource NullToVisInv}}">
            <ctrl:AmbientBackdrop/>
            <views:LibraryHome x:Name="HomeView" DataContext="{Binding Library}"/>
        </Grid>

        <!-- ======================= drop target ======================= -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Margin="10" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="5 4"
                       Stroke="{DynamicResource App.AccentSystemBrush}" Fill="{DynamicResource App.AccentSoftBrush}"/>
            <TextBlock Text="Drop to open" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.TextBrush}"/>
        </Grid>

        <!-- ======================= toast ======================= -->
        <Border x:Name="Toast" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource GlassCard}"
                Background="{DynamicResource App.GlassSolidBrush}" MaxWidth="380" Padding="16,12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.28"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Refresh}"
                          Stroke="#5FCB7E" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="13.5" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="ToastText" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                           Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="ToastAction" Style="{StaticResource AccentButton}" Click="ToastAction_Click"/>
                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" BorderThickness="0"
                            Background="Transparent" Content="Later" Click="ToastDismiss_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= command palette ======================= -->
        <Grid Grid.RowSpan="3" Background="#30000000"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="PaletteScrim_Click">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border x:Name="PaletteCard" Background="{DynamicResource App.GlassSolidBrush}"
                    Width="560" VerticalAlignment="Top" Margin="0,88,0,0" Padding="10"
                    RenderTransformOrigin="0.5,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PopIn}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" FontSize="15" Padding="10,8"
                             Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="PaletteBox_KeyDown"
                             ToolTip="Type a command"/>
                    <ListBox x:Name="PaletteList" Style="{StaticResource GList}" Margin="0,8,0,0" MaxHeight="380"
                             ItemsSource="{Binding PaletteResults}"
                             SelectedIndex="{Binding PaletteSelectedIndex}"
                             SelectionChanged="PaletteList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Background="Transparent" MouseLeftButtonUp="PaletteItem_Click">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                               FontSize="13" Margin="4,3"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
