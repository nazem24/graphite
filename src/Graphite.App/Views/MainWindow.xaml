<Window x:Class="Graphite.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Graphite.App.ViewModels"
        xmlns:ctrl="clr-namespace:Graphite.App.Controls"
        xmlns:conv="clr-namespace:Graphite.App.Converters"
        xmlns:core="clr-namespace:Graphite.Core;assembly=Graphite.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Graphite" Icon="/Assets/Graphite.ico" Width="1440" Height="900" MinWidth="960" MinHeight="560"
        Stylus.IsFlicksEnabled="False" Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsTapFeedbackEnabled="False" Stylus.IsTouchFeedbackEnabled="False"
        WindowStyle="None"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Background="{DynamicResource App.BackgroundBrush}"
        TextElement.Foreground="{DynamicResource App.TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="12.5">

    <shell:WindowChrome.WindowChrome>
        <!-- Custom chrome: keeps the native min/max/close buttons and Aero snap/shadow,
             but suppresses the default system icon + "Graphite" caption text. Our own
             glass command bar (below) supplies the visible branding/toolbar instead;
             the reserved strip above it is just a blank, draggable caption area. -->
        <shell:WindowChrome CaptionHeight="40"
                             GlassFrameThickness="-1"
                             CornerRadius="0"
                             ResizeBorderThickness="6"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True"/>
        <conv:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <conv:ZeroToVisibilityConverter x:Key="NonZeroToVis" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisInv" Invert="True"/>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:StringEqualsConverter x:Key="StrEquals"/>
        <conv:PlusOneConverter x:Key="PlusOne"/>
        <conv:ZoomToPercentConverter x:Key="ZoomToPercent"/>
        <conv:FileNameConverter x:Key="FileName"/>
        <conv:FileDirConverter x:Key="FileDir"/>

        <!-- ======================= document content ======================= -->
        <DataTemplate x:Key="DocTemplate" DataType="{x:Type vm:DocumentViewModel}">
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TranslateTransform/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1"
                                                 Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="8" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource EaseOut}"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ============ left sidebar: thumbnails / outline ============ -->
                <!-- The two side panels slide in/out from code (MainWindow.AnimatePanel): width,
                     margin and opacity animate together, and the content keeps a fixed width so it
                     slides instead of reflowing. Tag + Loaded sync the initial state. -->
                <Border Grid.Column="0" Width="208" Margin="12,4,0,12" ClipToBounds="True"
                        Style="{StaticResource GlassCard}" Tag="SidebarPanel" Loaded="Panel_Loaded">
                    <DockPanel Width="206" HorizontalAlignment="Right">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
                            <RadioButton x:Name="SideThumbs" Style="{StaticResource ToolToggle}" IsChecked="True"
                                         GroupName="Side" ToolTip="Thumbnails">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Thumbs}"/>
                            </RadioButton>
                            <RadioButton x:Name="SideOutline" Style="{StaticResource ToolToggle}" Margin="4,0,0,0"
                                         GroupName="Side" ToolTip="Outline">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Outline}"/>
                            </RadioButton>
                        </StackPanel>

                        <Grid>
                            <!-- thumbnails -->
                            <ListBox Style="{StaticResource GList}" ItemContainerStyle="{StaticResource ThumbListItem}"
                                     ItemsSource="{Binding Pages}"
                                     SelectedIndex="{Binding CurrentPageIndex, Mode=OneWay}"
                                     SelectionChanged="Thumbs_SelectionChanged"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Visibility="{Binding IsChecked, ElementName=SideThumbs, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Loaded="Thumb_Loaded" DataContextChanged="Thumb_DataContextChanged"
                                                    HorizontalAlignment="Center">
                                            <Border BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1"
                                                    Background="White" CornerRadius="4" ClipToBounds="True">
                                                <ctrl:FadeImage Source="{Binding Thumbnail}" Width="140"
                                                                Height="{Binding ThumbHeight}" Stretch="Uniform"/>
                                            </Border>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                            <StackPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Rotate left"
                                                              Command="{Binding Path=DataContext.RotatePageLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Rotate right"
                                                              Command="{Binding Path=DataContext.RotatePageRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Move up"
                                                              Command="{Binding Path=DataContext.MovePageUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Move down"
                                                              Command="{Binding Path=DataContext.MovePageDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                    <Separator/>
                                                    <MenuItem Header="Delete page"
                                                              Command="{Binding Path=DataContext.DeletePageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- outline -->
                            <Grid Visibility="{Binding IsChecked, ElementName=SideOutline, Converter={StaticResource BoolToVis}}">
                                <TreeView ItemsSource="{Binding Outline}" Margin="4"
                                          SelectedItemChanged="Outline_SelectedItemChanged">
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate DataType="{x:Type core:OutlineNode}" ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Body}" Margin="0,2"/>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                                <TextBlock Text="No outline in this document" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
                                           Visibility="{Binding Outline.Count, Converter={StaticResource ZeroToVis}}"/>
                            </Grid>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- ============ page viewer ============ -->
                <Border Grid.Column="1" Margin="12,4,12,12" CornerRadius="16"
                        Background="{DynamicResource App.ViewerBrush}">
                    <Grid>
                        <ListBox x:Name="PagesHost"
                                 ItemsSource="{Binding VisiblePages}"
                                 Loaded="PagesHost_Loaded" DataContextChanged="PagesHost_DataContextChanged"
                                 ScrollViewer.ScrollChanged="PagesHost_ScrollChanged"
                                 PreviewMouseWheel="PagesHost_PreviewMouseWheel"
                                 PreviewMouseLeftButtonDown="PagesHost_PreviewMouseLeftButtonDown"
                                 PreviewTouchDown="PagesHost_PreviewTouchDown"
                                 PreviewTouchMove="PagesHost_PreviewTouchMove"
                                 PreviewTouchUp="PagesHost_PreviewTouchUp"
                                 LostTouchCapture="PagesHost_LostTouchCapture"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource GList}">
                                    <Style.Triggers>
                                        <!-- Two-page spread lays its pair out side by side. -->
                                        <DataTrigger Binding="{Binding Layout}" Value="Spread">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Layout}" Value="Single">
                                            <Setter Property="ItemsPanel">
                                                <Setter.Value>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel VerticalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6" HorizontalAlignment="Center"
                                          Loaded="PageRoot_Loaded" DataContextChanged="PageRoot_DataContextChanged">
                                        <!-- The drop shadow sits on an empty sibling border rather than on the
                                             content border: a BitmapEffect re-renders its entire subtree into an
                                             intermediate surface whenever anything inside invalidates, so putting
                                             the page image + live annotation layer under the effect made every
                                             mouse-move while drawing re-run an 18px blur over the whole page. -->
                                        <Border BorderThickness="1"
                                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Doc.InvertPages}" Value="True">
                                                            <Setter Property="Background" Value="#141416"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28"/>
                                            </Border.Effect>
                                        </Border>
                                        <Border BorderBrush="#33000000" BorderThickness="1"
                                                Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <Grid>
                                                <!-- skeleton while the page bitmap is still being rendered -->
                                                <ctrl:ShimmerBorder Visibility="{Binding Image, Converter={StaticResource NullToVisInv}}"/>
                                                <ctrl:FadeImage Source="{Binding Image}" Stretch="Fill"/>
                                                <ctrl:AnnotationLayer/>
                                                <!-- Inline text editing host: the Text tool drops an empty
                                                     text box and typing happens right here on the page. -->
                                                <Canvas ClipToBounds="True">
                                                    <TextBox x:Name="InlineEditor" Visibility="Collapsed"
                                                             Loaded="InlineEditor_Loaded" DataContextChanged="InlineEditor_DataContextChanged"
                                                             LostFocus="InlineEditor_LostFocus" PreviewKeyDown="InlineEditor_KeyDown"
                                                             Background="Transparent" BorderThickness="0" Padding="0"
                                                             AcceptsReturn="False" VerticalContentAlignment="Top"/>
                                                </Canvas>
                                                <!-- "you landed here" flash (jumps, history, markup cards) -->
                                                <Border x:Name="FlashRing" IsHitTestVisible="False" Opacity="0"
                                                        BorderThickness="3" BorderBrush="{DynamicResource App.AccentSystemBrush}"
                                                        Background="{DynamicResource App.AccentSoftBrush}"/>
                                                <!-- OCR: a scan line while a page is being read, a shimmer when it is done -->
                                                <Grid x:Name="OcrFx" IsHitTestVisible="False" ClipToBounds="True" Visibility="Collapsed">
                                                    <Rectangle x:Name="OcrBand" Height="56" VerticalAlignment="Top">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#003E6DB5" Offset="0"/>
                                                                <GradientStop Color="#663E6DB5" Offset="0.85"/>
                                                                <GradientStop Color="#CC3E6DB5" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- floating page controls -->
                        <Border Style="{StaticResource GlassPill}" VerticalAlignment="Bottom" Tag="PageBar"
                                HorizontalAlignment="Center" Margin="0,0,0,16" Padding="7,4"
                                CornerRadius="21"
                                Background="{DynamicResource App.CardBrush}"
                                BorderBrush="{DynamicResource App.StrokeBrush}">
                            <StackPanel Orientation="Horizontal">
                                <!-- page navigation -->
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="PrevPage_Click" ToolTip="Previous page">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronLeft}"
                                          Width="11" Height="11" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="8,4" BorderThickness="0"
                                        Command="{Binding DataContext.GoToPageDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Go to page… (Ctrl+G)">
                                    <TextBlock Text="{Binding PageStatus, NotifyOnTargetUpdated=True}" FontSize="12"
                                               Foreground="{DynamicResource App.TextBrush}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="NextPage_Click" ToolTip="Next page">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronRight}"
                                          Width="11" Height="11" Stretch="Uniform"/>
                                </Button>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- zoom -->
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ZoomOutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Zoom out (Ctrl+-)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomOut}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="5,4" BorderThickness="0"
                                        Click="ZoomReset_Click" ToolTip="Reset zoom to 100%">
                                    <TextBlock Text="{Binding Zoom, Converter={StaticResource ZoomToPercent}}"
                                               VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource App.TextBrush}"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ZoomInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Zoom in (Ctrl++)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ZoomIn}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Padding="6" Click="FitWidth_Click" ToolTip="Fit width">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.FitWidth}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- layout -->
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6" GroupName="Layout"
                                             ToolTip="Continuous"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Continuous}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Continuous}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6" GroupName="Layout"
                                             ToolTip="Single page"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Single}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SinglePage}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>
                                <RadioButton Style="{StaticResource ToolToggle}" Padding="6" GroupName="Layout"
                                             ToolTip="Two pages"
                                             IsChecked="{Binding Layout, Converter={StaticResource EnumToBool}, ConverterParameter=Spread}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Spread}"
                                          Width="12" Height="12" Stretch="Uniform"/>
                                </RadioButton>

                                <Rectangle Style="{StaticResource ToolSep}" Height="15" Margin="6,0"/>

                                <!-- reading -->
                                <ToggleButton Style="{StaticResource IconButton}" Padding="6"
                                              IsChecked="{Binding InvertPages}"
                                              ToolTip="Dark pages">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Invert}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </ToggleButton>
                                <Button Style="{StaticResource IconButton}" Padding="6"
                                        Command="{Binding DataContext.ToggleFullscreenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Fullscreen (F11)">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Fullscreen}"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- busy overlay -->
                        <Border Background="#66000000" CornerRadius="16"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="Visibility" Value="Visible">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                                            </Trigger.EnterActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border Background="{DynamicResource App.GlassSolidBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                                        <Style.Triggers>
                                            <Trigger Property="IsVisible" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource PopIn}"/>
                                                </Trigger.EnterActions>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <ProgressBar IsIndeterminate="True" Width="220" Height="4"/>
                                    <TextBlock Text="{Binding BusyText}" Style="{StaticResource Body}"
                                               Margin="0,10,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============ right panel: comments / search ============ -->
                <Border Grid.Column="2" Width="292" Margin="0,4,12,12" ClipToBounds="True"
                        Style="{StaticResource GlassCard}" Tag="InspectorPanel" Loaded="Panel_Loaded">
                    <DockPanel Width="290" HorizontalAlignment="Left">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,10">
                            <RadioButton x:Name="TabComments" Style="{StaticResource ToolToggle}" IsChecked="True"
                                         GroupName="Inspector" ToolTip="Annotations">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Note}"/>
                                    <TextBlock Text="Markup" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabSearch" Style="{StaticResource ToolToggle}" Margin="4,0,0,0"
                                         GroupName="Inspector" Loaded="SearchRadio_Loaded" ToolTip="Search (Ctrl+F)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Search}"/>
                                    <TextBlock Text="Search" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Grid>
                            <!-- markup summary -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabComments, Converter={StaticResource BoolToVis}}">
                                <TextBlock DockPanel.Dock="Top" Margin="14,2,14,8" Style="{StaticResource Caption}"
                                           Text="{Binding Annotations.Count, StringFormat={}Annotations: {0}}"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Annotations}" Margin="10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource App.CardBrush}"
                                                        Tag="{Binding PulseCount, Mode=OneWay, NotifyOnTargetUpdated=True}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <TranslateTransform/>
                                                    </Border.RenderTransform>
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource App.StrokeSoftBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.AccentSystemBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <!-- Fires when the card first appears and on every click of it. -->
                                                    <Border.Triggers>
                                                        <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                            <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                                        </EventTrigger>
                                                    </Border.Triggers>
                                                    <Border.InputBindings>
                                                        <MouseBinding MouseAction="LeftClick" Command="{Binding GoToCommand}"/>
                                                    </Border.InputBindings>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <Rectangle Width="10" Height="10" RadiusX="3" RadiusY="3"
                                                                       Fill="{Binding Swatch}" VerticalAlignment="Center"/>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                    Click="DeleteCard_Click" Padding="3" ToolTip="Delete annotation">
                                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"
                                                                      Width="10" Height="10" Stretch="Uniform"/>
                                                            </Button>
                                                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Style="{StaticResource Body}">
                                                                <Run Text="{Binding KindLabel, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                <Run Text="{Binding PageLabel, Mode=OneWay}" Foreground="{DynamicResource App.TextSecondaryBrush}"/>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0">
                                                            <Run Text="{Binding Author, Mode=OneWay}"/> · <Run Text="{Binding When, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBox Text="{Binding Contents, UpdateSourceTrigger=LostFocus}"
                                                                 Margin="0,7,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                                                                 MinHeight="26" FontSize="12"
                                                                 ToolTip="Comment"/>
                                                        <ItemsControl ItemsSource="{Binding Replies}" Margin="10,6,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderBrush="{DynamicResource App.StrokeSoftBrush}"
                                                                            BorderThickness="1,0,0,0" Padding="8,2,0,4">
                                                                        <StackPanel>
                                                                            <TextBlock Style="{StaticResource Caption}">
                                                                                <Run Text="{Binding Author, Mode=OneWay}" FontWeight="SemiBold"/>
                                                                            </TextBlock>
                                                                            <TextBlock Text="{Binding Text}" Style="{StaticResource Body}"
                                                                                       TextWrapping="Wrap" FontSize="12"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <DockPanel Margin="10,6,0,0">
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                    Command="{Binding AddReplyCommand}" Margin="4,0,0,0" ToolTip="Reply">
                                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Reply}"
                                                                      Width="13" Height="13" Stretch="Uniform"/>
                                                            </Button>
                                                            <TextBox Text="{Binding ReplyDraft, UpdateSourceTrigger=PropertyChanged}"
                                                                     FontSize="12" ToolTip="Reply…"/>
                                                        </DockPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- search -->
                            <DockPanel Visibility="{Binding IsChecked, ElementName=TabSearch, Converter={StaticResource BoolToVis}}">
                                <StackPanel DockPanel.Dock="Top" Margin="14,2,14,6">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Click="SearchNext_Click" ToolTip="Next match (F3)">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"/>
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                Click="SearchPrev_Click" ToolTip="Previous match (Shift+F3)">
                                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronUp}"/>
                                        </Button>
                                        <TextBox Loaded="SearchBox_Loaded" KeyDown="SearchBox_KeyDown"
                                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Find in document"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding MatchStatus, NotifyOnTargetUpdated=True}"
                                               Style="{StaticResource Caption}" Margin="2,6,0,0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform/>
                                        </TextBlock.RenderTransform>
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                <BeginStoryboard Storyboard="{StaticResource ValuePulse}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </StackPanel>
                                <ListBox Style="{StaticResource GList}" ItemsSource="{Binding SearchResults}"
                                         SelectionChanged="Results_SelectionChanged" Margin="8,0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}"
                                                           Text="{Binding PageIndex, Converter={StaticResource PlusOne}, StringFormat={}Page {0}}"/>
                                                <TextBlock Text="{Binding Snippet}" Style="{StaticResource Body}"
                                                           TextWrapping="Wrap" FontSize="12"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding SaveCommand}"/>
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="K" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseDocumentCommand}"
                    CommandParameter="{Binding SelectedDocument}"/>
        <KeyBinding Modifiers="Ctrl" Key="G" Command="{Binding GoToPageDialogCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- title bar: document tabs + caption buttons -->
            <RowDefinition Height="Auto"/>   <!-- command bar -->
            <RowDefinition Height="*"/>      <!-- document / start page -->
        </Grid.RowDefinitions>

        <!-- ======================= document tabs (title bar) ======================= -->
        <!-- Browser-style: the tabs sit in the caption strip above the command bar. Only
             the tabs themselves are click-through-to-the-app; every other pixel of the strip
             still drags the window. Right margin leaves room for the caption buttons. -->
        <Grid Grid.Row="0" Height="40" Margin="12,0,122,0"
              Visibility="{Binding IsFullscreen, Converter={StaticResource InvBoolToVis}}">
            <ListBox x:Name="TabStrip" Style="{StaticResource DocTabStrip}"
                     ItemContainerStyle="{StaticResource DocTabItem}"
                     HorizontalAlignment="Left" VerticalAlignment="Center"
                     Visibility="{Binding Documents.Count, Converter={StaticResource NonZeroToVis}}"
                     ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}"
                     SelectionChanged="TabStrip_SelectionChanged"
                     PreviewMouseWheel="TabStrip_PreviewMouseWheel"
                     PreviewMouseDown="TabStrip_PreviewMouseDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FilePath}">
                            <TextBlock Text="{Binding Title}" MaxWidth="170" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="●" FontSize="8" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource App.AccentSystemBrush}"
                                       Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource IconButton}" Padding="4" Margin="6,0,0,0"
                                    ToolTip="Close (Ctrl+W)"
                                    Command="{Binding DataContext.CloseDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}"
                                      Width="9" Height="9" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ======================= floating glass command bar ======================= -->
        <Border x:Name="CommandBar" Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="14" Margin="12,0,12,6"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource RiseIn}"/>
                </EventTrigger>
            </Border.Triggers>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <DockPanel Margin="10,6">
                <!-- brand -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <Grid Width="16" Height="16">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Outer}"
                              Stroke="{DynamicResource App.TextBrush}" StrokeThickness="1.7"/>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Inner}"
                              Stroke="{DynamicResource App.BrandBlueBrush}" StrokeThickness="1.7"/>
                    </Grid>
                    <TextBlock Text="Graphite" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- right side -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding OpenPaletteCommand}"
                            ToolTip="Command palette (Ctrl+K)">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Command}"/>
                    </Button>
                    <ToggleButton Style="{StaticResource IconButton}" IsChecked="{Binding ShowSidebar}" ToolTip="Sidebar">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Sidebar}"/>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource IconButton}" IsChecked="{Binding ShowInspector}" ToolTip="Markup panel">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Inspector}"/>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Theme">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Theme}"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform/>
                            </Path.RenderTransform>
                            <Path.Triggers>
                                <EventTrigger RoutedEvent="Mouse.PreviewMouseDown">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             By="150" Duration="0:0:0.28" EasingFunction="{StaticResource EaseOutSoft}"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Path.Triggers>
                        </Path>
                    </Button>
                </StackPanel>

                <!-- center: file + tools -->
                <StackPanel Orientation="Horizontal">
                    <!-- File: open/save/print/security/properties, collapsed into one menu -->
                    <Button Style="{StaticResource IconButton}" Click="OrganizeMenu_Click" ToolTip="File">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="FileIcon" Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}"/>
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                  Width="10" Height="10" Stretch="Uniform" Margin="3,0,0,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Open}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open from OneDrive" Command="{Binding OpenOneDriveCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cloud}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Save" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Save}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.SaveAs}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save encrypted copy…" Command="{Binding SaveEncryptedCopyCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lock}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Print…" InputGestureText="Ctrl+P" Command="{Binding PrintCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Print}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Document properties" Command="{Binding ShowPropertiesCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Info}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Check for updates…" Command="{Binding CheckForUpdatesCommand}">
                                    <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}" Width="14" Height="14"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Grid>
                    <!-- Selection pill: one shared highlight that glides to whichever tool is active
                         (MainWindow.UpdateToolPill); the buttons' own selected fill is switched off
                         through Tag="Glide". -->
                    <Border x:Name="ToolPill" Width="32" Height="32" CornerRadius="9" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                            Background="{DynamicResource App.AccentSoftBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>
                    </Border>
                    <StackPanel x:Name="ToolsPanel" Orientation="Horizontal"
                                ToggleButton.Checked="Tools_CheckedChanged" ToggleButton.Unchecked="Tools_CheckedChanged">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedDocument}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <Button Style="{StaticResource IconButton}" Command="{Binding UndoCommand}" ToolTip="Undo (Ctrl+Z)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Undo}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding RedoCommand}" ToolTip="Redo (Ctrl+Y)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Redo}"/>
                        </Button>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- organize menu -->
                        <Button Style="{StaticResource IconButton}" Click="OrganizeMenu_Click" ToolTip="Pages">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.InsertPage}"/>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Merge PDFs…" Command="{Binding MergeCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Merge}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Split into single pages…" Command="{Binding SplitCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Split}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Insert pages from PDF…" Command="{Binding InsertPagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.InsertPage}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Insert blank page" Command="{Binding InsertBlankPageCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Add}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Delete pages…" Command="{Binding DeletePagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Delete}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Extract pages…" Command="{Binding ExtractPagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Extract}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Rotate page left" Command="{Binding RotatePageLeftCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateLeft}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Rotate page right" Command="{Binding RotatePageRightCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.RotateRight}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <!-- export / convert menu (OCR lives here too) -->
                        <Button Style="{StaticResource IconButton}" Click="OrganizeMenu_Click" ToolTip="Export">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}"/>
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.ChevronDown}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="3,0,0,0"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Export to Word (.docx)…" Command="{Binding ExportWordCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export to Excel (.xlsx)…" Command="{Binding ExportExcelCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export to PowerPoint (.pptx)…" Command="{Binding ExportPowerPointCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Export}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Export pages as images…" Command="{Binding ExportImagesCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Image}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Recognize text (OCR)…" Command="{Binding RunOcrCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Ocr}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- select + text markup -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Select"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Select}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Select}"/>
                        </RadioButton>
                        <!-- Lasso: draw a loop around ink, shapes and text boxes to grab them, then
                             drag to move, press Delete (or the × chip) to remove, or pick a colour. -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Lasso — draw a loop to select markup, then move or delete it"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Lasso}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Lasso}"/>
                        </RadioButton>
                        <!-- Highlight (text mode): drag over words to snap-highlight them.
                             The freehand marker variant lives with the pen and eraser below. -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Highlight — drag over text to snap-highlight words"
                                     IsChecked="{Binding SelectedDocument.IsTextHighlightActive}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.TextHighlight}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Underline"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Underline}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Underline}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Strikethrough"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=StrikeOut}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Strike}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- pen + freehand marker + eraser -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Pen"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ink}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Ink}"/>
                        </RadioButton>
                        <!-- Freehand marker: translucent highlighter stroke drawn anywhere on
                             the page (the text-snapping variant lives with underline/strike). -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Marker — draw a translucent freehand highlight"
                                     IsChecked="{Binding SelectedDocument.IsFreehandMarkerActive}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.MarkerFreehand}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Eraser"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Eraser}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Eraser}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- shapes + text -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Text box"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Text}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.TextTool}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Arrow"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Arrow}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Arrow}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Rectangle"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rect}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Rect}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide" ToolTip="Ellipse"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ellipse}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Ellipse}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- signature + content -->
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Signature — click again to edit"
                                     PreviewMouseLeftButtonDown="SignatureTool_PreviewMouseDown"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=Signature}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Signature}"/>
                            <RadioButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Edit signature…" Command="{Binding EditSignatureCommand}">
                                        <MenuItem.Icon><Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Signature}" Width="14" Height="14"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </RadioButton.ContextMenu>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Insert image"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=PlaceImage}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Image}"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ToolToggle}" GroupName="Tools" Tag="Glide"
                                     ToolTip="Edit page text"
                                     IsChecked="{Binding SelectedDocument.ActiveTool, Converter={StaticResource EnumToBool}, ConverterParameter=EditText}">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.EditText}"/>
                        </RadioButton>

                        <Rectangle Style="{StaticResource ToolSep}"/>

                        <!-- markup colour + thickness, grouped as one quiet chip -->
                        <Border CornerRadius="11" BorderThickness="1" Padding="1" Margin="2,0,0,0"
                                BorderBrush="{DynamicResource App.StrokeBrush}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">

                                <!-- markup colour: a swatch palette instead of a text list -->
                                <ToggleButton x:Name="ColorToggle" Style="{StaticResource IconButton}"
                                              ToolTip="Markup color"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=ColorPopup, Converter={StaticResource InvertBool}}">
                                    <Border Width="16" Height="16" CornerRadius="8"
                                            BorderBrush="{DynamicResource App.StrokeBrush}" BorderThickness="1"
                                            Background="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource HexToBrush}}"/>
                                </ToggleButton>
                                <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorToggle}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="None"
                                       IsOpen="{Binding IsChecked, ElementName=ColorToggle, Mode=TwoWay}"
                                       Opened="ColorPopup_Opened">
                                    <Border x:Name="ColorCard" Margin="12,4,12,18" Padding="10"
                                            CornerRadius="14" BorderThickness="1"
                                            Background="{DynamicResource App.GlassSolidBrush}"
                                            BorderBrush="{DynamicResource App.GlassBorderBrush}"
                                            RenderTransformOrigin="0.5,0">
                                        <Border.RenderTransform>
                                            <ScaleTransform/>
                                        </Border.RenderTransform>
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.32"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Markup colour" Style="{StaticResource Caption}" Margin="4,0,0,6"/>
                                            <UniformGrid Columns="5">
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#F2C744" ToolTip="Yellow"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#F2C744, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#F2C744" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#E8853C" ToolTip="Orange"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#E8853C, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#E8853C" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#C24444" ToolTip="Red"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#C24444, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#C24444" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#C75E9A" ToolTip="Pink"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#C75E9A, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#C75E9A" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#3E6DB5" ToolTip="Blue"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#3E6DB5, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#3E6DB5" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#2E8C83" ToolTip="Teal"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#2E8C83, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#2E8C83" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#4E9C51" ToolTip="Green"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#4E9C51, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#4E9C51" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#7B5EC7" ToolTip="Purple"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#7B5EC7, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#7B5EC7" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#3B3B38" ToolTip="Graphite"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#3B3B38, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#3B3B38" Click="ColorSwatch_Click"/>
                                                <RadioButton Style="{StaticResource SwatchButton}" Background="#111111" ToolTip="Black"
                                                             IsChecked="{Binding SelectedDocument.ActiveColorHex, Converter={StaticResource StrEquals}, ConverterParameter=#111111, Mode=OneWay}"
                                                             Command="{Binding SetToolColorCommand}" CommandParameter="#111111" Click="ColorSwatch_Click"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- stroke thickness -->
                                <Button Style="{StaticResource IconButton}" Click="OrganizeMenu_Click"
                                        ToolTip="Stroke thickness">
                                    <TextBlock Text="{Binding SelectedDocument.ActiveStrokeWidth, StringFormat={}{0} pt}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                    <Button.ContextMenu>
                                        <ContextMenu MinWidth="190">
                                            <MenuItem Header="Hairline" InputGestureText="1 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="1">
                                                <MenuItem.Icon><Border Width="16" Height="1" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Fine" InputGestureText="1.5 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="1.5">
                                                <MenuItem.Icon><Border Width="16" Height="1.5" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Regular" InputGestureText="2 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="2">
                                                <MenuItem.Icon><Border Width="16" Height="2" CornerRadius="1" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Bold" InputGestureText="3 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="3">
                                                <MenuItem.Icon><Border Width="16" Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Heavy" InputGestureText="4.5 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="4.5">
                                                <MenuItem.Icon><Border Width="16" Height="4.5" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Marker" InputGestureText="6 pt" Command="{Binding SetToolWidthCommand}" CommandParameter="6">
                                                <MenuItem.Icon><Border Width="16" Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{DynamicResource App.TextBrush}"/></MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ======================= custom caption buttons ======================= -->
        <!-- WindowChrome's built-in UseAeroCaptionButtons doesn't reliably draw anything
             on modern Windows, so minimize/maximize/close are drawn here by hand. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Height="40" Visibility="{Binding IsFullscreen, Converter={StaticResource InvBoolToVis}}">
            <Button Style="{StaticResource IconButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MinimizeButton_Click" ToolTip="Minimize">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.WinMinimize}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
            <Button x:Name="MaximizeRestoreButton" Style="{StaticResource IconButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                <Path x:Name="MaximizeRestoreIcon" Style="{StaticResource IconPath}" Data="{StaticResource Icon.WinMaximize}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
            <Button Style="{StaticResource CaptionCloseButton}" Padding="12,13" Focusable="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="CloseButton_Click" ToolTip="Close">
                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Close}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
        </StackPanel>

        <!-- ======================= documents ======================= -->
        <!-- The tab strip above only selects; the selected document is shown here. One
             presenter is reused across documents (the window re-targets its scroll state
             when the DataContext swaps), exactly as the old TabControl did. -->
        <ContentControl x:Name="DocHost" Grid.Row="2" Focusable="False" IsTabStop="False"
                        Content="{Binding SelectedDocument}"
                        ContentTemplate="{StaticResource DocTemplate}"
                        Visibility="{Binding Documents.Count, Converter={StaticResource NonZeroToVis}}"
                        RenderTransformOrigin="0.5,0.5">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
        </ContentControl>

        <!-- ======================= start page ======================= -->
        <Grid Grid.Row="2" Visibility="{Binding Documents.Count, Converter={StaticResource ZeroToVis}}">
            <ctrl:AmbientBackdrop/>
            <Border Style="{StaticResource GlassCard}" Width="480" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Padding="36,40" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard Storyboard="{StaticResource RiseIn}"/>
                    </EventTrigger>
                </Border.Triggers>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="6" Direction="270" Opacity="0.18"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Width="16" Height="16" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="3.4" ScaleY="3.4"/>
                        </Grid.RenderTransform>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Outer}"
                              Stroke="{DynamicResource App.TextBrush}" StrokeThickness="1.5"/>
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Logo.Inner}"
                              Stroke="{DynamicResource App.BrandBlueBrush}" StrokeThickness="1.5"/>
                    </Grid>
                    <TextBlock Text="Graphite" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,34,0,2"/>
                    <TextBlock Text="Read, mark up, and edit PDFs." Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource AccentButton}" Command="{Binding OpenCommand}" Content="Open document…"/>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding OpenOneDriveCommand}"
                                Content="Open from OneDrive" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="or drag a PDF or Office file into this window"
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,12,0,0"/>

                    <TextBlock Text="Recent files" Style="{StaticResource Caption}" Margin="6,30,0,6" FontSize="10"
                               Visibility="{Binding RecentFiles.Count, Converter={StaticResource NonZeroToVis}}"/>
                    <ListBox Style="{StaticResource GList}" ItemsSource="{Binding RecentFiles}" MaxHeight="220"
                             SelectionChanged="RecentList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,1">
                                    <TextBlock Text="{Binding Converter={StaticResource FileName}}"
                                               Style="{StaticResource Body}" FontSize="12.5"/>
                                    <TextBlock Text="{Binding Converter={StaticResource FileDir}}"
                                               Style="{StaticResource Caption}" Margin="0,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Margin="4,22,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Padding="4,2"
                                Command="{Binding CheckForUpdatesCommand}" ToolTip="Check for updates">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Download}"
                                      Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Check for updates" Style="{StaticResource Caption}" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding AppVersion, StringFormat={}Version {0}}"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================= drop target ======================= -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="3" Margin="10" IsHitTestVisible="False" Visibility="Collapsed">
            <Rectangle RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="5 4"
                       Stroke="{DynamicResource App.AccentSystemBrush}" Fill="{DynamicResource App.AccentSoftBrush}"/>
            <TextBlock Text="Drop to open" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource App.TextBrush}"/>
        </Grid>

        <!-- ======================= toast ======================= -->
        <Border x:Name="Toast" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource GlassCard}"
                Background="{DynamicResource App.GlassSolidBrush}" MaxWidth="380" Padding="16,12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.28"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="ToastText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Later" Click="ToastDismiss_Click"/>
                    <Button x:Name="ToastAction" Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                            Click="ToastAction_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= command palette ======================= -->
        <Grid Grid.RowSpan="3" Background="#30000000"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVis}}"
              MouseLeftButtonDown="PaletteScrim_Click">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource FadeIn}"/>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border x:Name="PaletteCard" Background="{DynamicResource App.GlassSolidBrush}"
                    Width="560" VerticalAlignment="Top" Margin="0,88,0,0" Padding="10"
                    RenderTransformOrigin="0.5,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Storyboard="{StaticResource PopIn}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="36" ShadowDepth="8" Direction="270" Opacity="0.35"/>
                </Border.Effect>
                <DockPanel>
                    <TextBox x:Name="PaletteBox" DockPanel.Dock="Top" FontSize="15" Padding="10,8"
                             Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="PaletteBox_KeyDown"
                             ToolTip="Type a command"/>
                    <ListBox x:Name="PaletteList" Style="{StaticResource GList}" Margin="0,8,0,0" MaxHeight="380"
                             ItemsSource="{Binding PaletteResults}"
                             SelectedIndex="{Binding PaletteSelectedIndex}"
                             SelectionChanged="PaletteList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Background="Transparent" MouseLeftButtonUp="PaletteItem_Click">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Gesture}"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}"
                                               FontSize="13" Margin="4,3"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
